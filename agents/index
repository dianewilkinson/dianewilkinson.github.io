    :root{
      --bg:#f9fafb;
      --card:#ffffff;
      --text:#111827;
      --muted:#4b5563;
      --border:#e5e7eb;
      --link:#2563eb;
      --link-soft:#4f46e5;
      --shadow:rgba(15,23,42,0.08);
      --accent-grad:linear-gradient(135deg,#f97373,#fb7185,#a855f7,#6366f1);
