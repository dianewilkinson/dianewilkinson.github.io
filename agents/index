    /* Footer */
    footer{
      text-align:center;
      margin:16px 0 20px;
      color:var(--muted);
      font-size:13px;
    }
    footer .footline{
      max-width:1120px;
      margin:10px auto 0;
      padding:0 20px;
    }
  </style>
</head>

