    }
    *{box-sizing:border-box;}
    body{
      margin:0;
      background:var(--bg);
      color:var(--text);
      font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;
    }
    a{color:var(--link);text-decoration:none;}
    a:hover{text-decoration:underline;}
    .bar{height:4px;background:var(--accent-grad);}

    header{
      text-align:center;
      padding:32px 16px 16px;
    }
    header h1{
      margin:0;
      font-size:24px;
      font-weight:700;
    }
    header p{
      margin:10px 0 0;
      color:var(--muted);
      font-size:14px;
      line-height:1.6;
    }

    .wrap{
      max-width:1120px;
      margin:0 auto;
      padding:20px 20px 32px;
    }

    /* HERO */
    .hero{
      margin:6px 0 18px;
      border-radius:20px;
      background:linear-gradient(120deg,#fde7ef,#f3e8ff,#e0ecff);
      box-shadow:0 8px 24px var(--shadow);
      padding:26px 26px 22px;
      display:flex;
      gap:18px;
      align-items:flex-start;
      flex-wrap:wrap;
    }
    .hero-left{
      flex:1 1 520px;
      min-width:0;
    }
    .hero-eyebrow{
      display:inline-flex;
      padding:4px 10px;
      border-radius:999px;
      background:rgba(255,255,255,.85);
      border:1px solid rgba(148,163,184,.5);
      font-size:11px;
      font-weight:500;
      letter-spacing:.04em;
      text-transform:uppercase;
      color:#4b5563;
      margin-bottom:10px;
    }
    .hero-left h2{
      margin:0 0 6px;
      font-size:26px;
      line-height:1.3;
    }
    .hero-left h2 span{ color:var(--link-soft); }
    .hero-sub{
      margin:0;
      font-size:15px;
      color:var(--muted);
      line-height:1.7;
    }

    .hero-actions{
      margin-top:12px;
      display:flex;
      gap:10px;
      flex-wrap:wrap;
      align-items:center;
    }
    .pill-link{
      display:inline-flex;
      align-items:center;
      gap:6px;
      padding:7px 12px;
      border-radius:999px;
      font-size:13px;
      font-weight:600;
      color:#4f46e5;
      background:rgba(255,255,255,0.92);
      border:1px solid rgba(148,163,184,0.8);
      text-decoration:none;
    }
    .pill-link:hover{
      background:rgba(255,255,255,1);
      text-decoration:none;
      color:#4338ca;
    }

    @media (max-width:720px){
      .hero{ padding:20px 18px 18px; }
      .hero-left h2{ font-size:22px; }
    }

    .section-note{
      font-size:13px;
      color:#6b7280;
      margin:8px 0 14px;
    }

    /* Section headings */
    h2.section-title{
      font-size:20px;
      margin:22px 0 14px;
      display:flex;
      align-items:center;
      gap:8px;
    }
    h2.section-title span.emoji{ font-size:20px; }

    /* Cards grid */
    .grid{
      display:grid;
      gap:16px;
      grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
    }
    .card{
      background:var(--card);
      border:1px solid var(--border);
      border-radius:16px;
      padding:14px 14px 12px;
      box-shadow:0 1px 3px var(--shadow);
      display:flex;
      flex-direction:column;
      min-height:170px;
