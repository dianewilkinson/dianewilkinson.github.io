    .suite-head .suite-actions{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
      align-items:center;
      margin-top:2px;
    }

    .suite-grid{
      display:grid;
      grid-template-columns:repeat(4, minmax(220px, 1fr));
      gap:0;
    }
    @media (max-width:1100px){
      .suite-grid{ grid-template-columns:repeat(2, minmax(220px, 1fr)); }
    }
    @media (max-width:620px){
      .suite-grid{ grid-template-columns:1fr; }
    }

    .suite-col{
      padding:14px 14px 12px;
      border-right:1px solid #eef2f7;
    }
    .suite-col:last-child{ border-right:none; }
    @media (max-width:1100px){
      .suite-col:nth-child(2n){ border-right:none; }
      .suite-col{ border-bottom:1px solid #eef2f7; }
      .suite-col:nth-last-child(-n+2){ border-bottom:none; }
    }
    @media (max-width:620px){
      .suite-col{ border-right:none; border-bottom:1px solid #eef2f7; }
      .suite-col:last-child{ border-bottom:none; }
