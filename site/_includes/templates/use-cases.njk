{# =========================
   USE CASES TEMPLATE — Eleventy layout
   Uses ONLY existing site.css classes
   ========================= #}

{% extends "layouts/base.njk" %}

{% block crumbs %}
  <a href="/">Home</a>
  <span class="sep">/</span>
  <span>Use Cases</span>
{% endblock %}

{% block heroTitle %}
  {% if heroTitle %}
    {{ heroTitle | safe }}
  {% else %}
    {{ h1 or title or "Use Cases" | safe }}
  {% endif %}
{% endblock %}


{% block content %}
  {{ content | safe }}
{% endblock %}
