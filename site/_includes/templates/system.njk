{# =========================
   SYSTEM TEMPLATE — Eleventy layout
   Uses ONLY existing site.css classes
   ========================= #}

{% extends "layouts/base.njk" %}

{% block crumbs %}
  <a href="/">Home</a>
  <span class="sep">/</span>
  <span>System</span>
{% endblock %}

{% block heroTitle %}
  {% if heroTitle %}
    {{ heroTitle | safe }}
  {% else %}
    {{ h1 or title or "System" | safe }}
  {% endif %}
{% endblock %}

{% block ctas %}
  <span class="ctaLabel">Explore →</span>
  <a class="btn" href="/tools/">Tools</a>
  <a class="btn" href="/use-cases/">Cases</a>
{% endblock %}

{% block content %}
  {{ content | safe }}
{% endblock %}
