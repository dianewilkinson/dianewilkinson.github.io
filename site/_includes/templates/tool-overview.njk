{% extends "layouts/base.njk" %}

{% block crumbs %}
<a href="/">Home</a> <span class="sep">/</span>
<a href="/tools/">Tools</a> <span class="sep">/</span>
<a href="/tools/{{ toolSlug }}/">{{ toolName }}</a>

<span class="sep">/</span>
<span>Overview</span>
{% endblock %}

{% block heroTitle %}
{{ heroTitle | safe }}
{% endblock %}

{% block ctas %}
<span class="ctaLabel">Explore →</span>
<span class="btn primary">Overview</span>
<a class="btn" href="/tools/{{ toolSlug }}/playbook/">Playbook</a>
<a class="btn" href="/tools/{{ toolSlug }}/demo/">Demo</a>
<a class="btn" href="/use-cases/">Cases</a>
{% endblock %}

{% block content %}

{# Above-the-fold: iframe demo #}
<section class="demo" aria-label="{{ toolName }} Demo">
  <div class="demoHead">
    <div class="label"><span class="dot"></span> Demo Preview</div>
    <a href="/tools/{{ toolSlug }}/demo/">Open full demo →</a>
  </div>
  <iframe
    class="demoFrame"
    src="/tools/{{ toolSlug }}/demo-embed/"
    title="{{ toolName }} Demo (embedded)"></iframe>
</section>

{# What it solves (directly under iframe) #}
{% if solves %}
<section class="full" aria-label="What {{ toolName }} solves">
  <h2 class="section-title">What the Tool Solves</h2>
  <p class="muted">{{ solves | safe }}</p>
</section>
{% endif %}

{# Before / After (side-by-side cards) #}
{% if before or after %}
<section class="grid2" aria-label="Before and after">
  <div class="card">
    <h2 class="section-title"><span class="accent">Without</span> {{ toolName }} Tool</h2>
    {% if before %}
    <ul>
      {% for item in before %}
      <li>{{ item | safe }}</li>
      {% endfor %}
    </ul>
    {% endif %}
  </div>

  <aside class="card">
    <h2 class="section-title"><span class="accent">With</span> {{ toolName }} Tool</h2>
    {% if after %}
    <ul>
      {% for item in after %}
      <li>{{ item | safe }}</li>
      {% endfor %}
    </ul>
    {% endif %}
  </aside>
</section>
{% endif %}

{# Signals tracked (NOT bullets) #}
{% if signals %}
<section class="full" aria-label="Signals Tracked">
  <h2 class="section-title">Signals tracked</h2>

  <div class="miniGrid" aria-label="Signals tracked">
    {% for s in signals %}
    <div class="mini">
      <span>{{ s | safe }}</span>
    </div>
    {% endfor %}
  </div>
</section>
{% endif %}

{# Outcomes + case study link inside this card #}
{% if outcomes %}
<section class="full" aria-label="{{ toolName }} outcomes">
  <h2 class="section-title">Outcomes</h2>

  <div class="miniGrid" aria-label="Outcome pillars">
    {% for o in outcomes %}
    <div class="mini">
      <b>{{ o.title }}</b>
      <span>{{ o.desc }}</span>
    </div>
    {% endfor %}
  </div>

{% if caseStudy and caseStudy.href %}
  <div class="rule"></div>
  <p class="small">
    <a href="{{ caseStudy.href }}"><strong>{{ caseStudy.label or "See it in a live workflow →" }}</strong></a>
    {% if caseStudy.desc %}
      <br />{{ caseStudy.desc }}
    {% endif %}
  </p>
{% endif %}

{% if note %}
  <div class="rule"></div>
  <p class="small">
    {{ note }}
  </p>
{% endif %}

</section>
{% endif %}

{# Page-specific content (must appear exactly once) #}
{{ content | safe }}

{% endblock %}
