{# =========================
   HOME TEMPLATE — Eleventy layout
   Uses ONLY existing site.css classes
   ========================= #}

{% extends "layouts/base.njk" %}

{% block content %}

  <section class="hero hero--home" aria-label="Hero">
    <h2 class="hero-headline">{{ heroHeadline | safe }}</h2>

    {% if heroSubtitle %}
      <p class="hero-subtitle">{{ heroSubtitle }}</p>
    {% endif %}

    {% if heroActions %}
      <div class="hero-actions">
        {{ heroActions | safe }}
      </div>
    {% endif %}
  </section>

  {{ content | safe }}

    {# OPTIONAL: Featured tools grid powered by site/_data/tools.json #}
  {% if showFeaturedTools %}
    {% set limit = featuredToolsLimit or 8 %}
    {% set featured = tools | selectattr("card.featured", "equalto", true) | list %}

    <section class="panel" aria-label="Featured tools">
      <div class="panelInner">
        <h3 class="section-title">{{ featuredToolsTitle or "Featured Systems" }}</h3>
        {% if featuredToolsSub %}
          <p class="section-sub">{{ featuredToolsSub }}</p>
        {% endif %}

        <div class="tools-grid" aria-label="Featured tools grid">
          {% for item in featured | slice(0, limit) %}
            <div class="tool-card">
              <div class="tool-top">
                <div>
                  <p class="small muted">{{ item.card.type | replace("-", " ") | title }}</p>
                  <h3>{{ item.card.title }}</h3>
                  <p>{{ item.card.summary }}</p>
                </div>
                {% if item.card.function %}
                  <span class="badge">{{ item.card.function }}</span>
                {% endif %}
              </div>
              <div class="tool-actions">
                <a href="{{ item.card.href }}">Explore →</a>
              </div>
            </div>
          {% endfor %}

          {# Route card: full library #}
          <div class="tool-card is-route is-route--cool" aria-label="Browse all tools">
            <div class="tool-top">
              <div>
                <h3>↗ Browse all tools</h3>
                <p>View the complete library — tools, playbooks, system docs, and articles.</p>
              </div>
              <span class="badge">Full library</span>
            </div>
            <div class="tool-actions">
              <a href="/tools/">Open tools index →</a>
            </div>
          </div>

        </div>
      </div>
    </section>
  {% endif %}

{% endblock %}
