{# =========================
   TEMPLATE — Article
   Uses ONLY existing site.css classes
   ========================= #}

{% set minimalShell = true %}

{% extends "layouts/base.njk" %}

{% block content %}

  {# HERO (matches site shell) #}
  <section class="hero hero--tool" aria-label="Article hero">

    {% if kicker %}
      <div class="kicker">
        <span class="kdot"></span>
        {{ kicker | safe }}
      </div>
    {% endif %}

    <h1>{{ (heroTitle or title) | safe }}</h1>

    {% if sub %}
      <p class="sub">{{ sub | safe }}</p>
    {% endif %}

    {% if authorLine or readTime or backHref %}
      <div class="backRow backRow--split">
        <div>
          {% if backHref %}
            <a class="backLink" href="{{ backHref }}">← {{ backLabel or "Back" }}</a>
          {% endif %}

          {% if authorLine or readTime %}
            <div class="small muted">
              {% if authorLine %}{{ authorLine | safe }}{% endif %}
              {% if authorLine and readTime %} · {% endif %}
              {% if readTime %}{{ readTime | safe }}{% endif %}
            </div>
          {% endif %}
        </div>

        {% if ctaNote %}
          <div class="ctaRow ctaRow--tight">
            {{ ctaNote | safe }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="hairline"></div>

    {% if crumbTitle %}
      <div class="callout">{{ crumbTitle | safe }}</div>
    {% endif %}

  </section>

  {# ARTICLE BODY SURFACE #}
  <article class="prose narrow" aria-label="Article">

    {{ content | safe }}

    {% if tags %}
      <div class="rule"></div>
      <h2 class="section-title">Tags</h2>
      <div aria-label="Tags list">
        {% for t in tags %}
          <span class="badge">{{ t }}</span>
        {% endfor %}
      </div>
    {% endif %}

    {% if ctaTitle or ctaBody %}
      <div class="rule"></div>

      {% if ctaTitle %}
        <h2 class="section-title">{{ ctaTitle | safe }}</h2>
      {% endif %}

      {% if ctaBody %}
        <p class="section-sub">{{ ctaBody | safe }}</p>
      {% endif %}
    {% endif %}

  </article>

{% endblock %}
