{# =========================
   BASE LAYOUT — CONTRACTED SHELL
   ========================= #}

<!doctype html>
<html lang="en">
<head>
  {% set _siteUrl = siteUrl or "https://dianewilkinson.github.io" %}
  {% set _path = "/" %}
  {% if canonicalPath %}
    {% set _path = canonicalPath %}
  {% elseif page and page.url %}
    {% set _path = page.url %}
  {% endif %}
  {% set _canonical = canonical or (_siteUrl ~ _path) %}
  {% set _metaTitle = (metaTitle or ogTitle or title or "Diane Wilkinson") | striptags %}
  {% set _metaDescription = metaDescription or ogDescription or description or "AI-native people operations systems, tools, and playbooks by Diane Wilkinson." %}
  {% set _ogType = ogType or "website" %}
  {% set _twitterSite = twitterSite or "" %}
  {% set _twitterCreator = twitterCreator or "" %}
  {% set _robots = robots or ("noindex, nofollow" if noindex else "index, follow") %}
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{{ _metaTitle }}</title>
  <meta name="description" content="{{ _metaDescription }}" />
  <meta name="robots" content="{{ _robots }}" />
  <link rel="canonical" href="{{ _canonical }}" />

  <meta property="og:type" content="{{ _ogType }}" />
  <meta property="og:title" content="{{ ogTitle or _metaTitle }}" />
  <meta property="og:description" content="{{ ogDescription or _metaDescription }}" />
  <meta property="og:url" content="{{ ogUrl or _canonical }}" />
  <meta property="og:site_name" content="{{ ogSiteName or "Diane Wilkinson" }}" />
  {% if ogImage %}
    <meta property="og:image" content="{{ ogImage }}" />
  {% endif %}

  <meta name="twitter:card" content="{{ "summary_large_image" if ogImage else "summary" }}" />
  <meta name="twitter:title" content="{{ twitterTitle or ogTitle or _metaTitle }}" />
  <meta name="twitter:description" content="{{ twitterDescription or ogDescription or _metaDescription }}" />
  {% if _twitterSite %}
    <meta name="twitter:site" content="{{ _twitterSite }}" />
  {% endif %}
  {% if _twitterCreator %}
    <meta name="twitter:creator" content="{{ _twitterCreator }}" />
  {% endif %}
  {% if ogImage %}
    <meta name="twitter:image" content="{{ ogImage }}" />
  {% endif %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap">
  <link rel="stylesheet" href="/assets/css/site.css?v=4">
</head>

<body data-page="{{ pageId }}">
  <div class="bar"></div>

  <main class="wrap">

    {% if (not minimalShell) and (pageId != "home") %}
      <div class="topbar">
        <div class="crumbs">
          {% block crumbs %}{% endblock %}
        </div>
      </div>

      <header class="hero {{ heroClass or 'hero--tool' }}">
        {% if kicker %}
          <div class="kicker">
            <span class="kdot"></span>
            {{ kicker }}
          </div>
        {% endif %}

        <h1>{% block heroTitle %}{{ (h1 or title or "Page") | safe }}{% endblock %}</h1>

        {% if sub %}
          <p class="sub">{{ sub | safe }}</p>
        {% endif %}

        {# OPTIONAL HERO CALLOUT (text-only) #}
        {% if callout %}
          <div class="callout">{{ callout | safe }}</div>
        {% endif %}

        <div class="backRow backRow--split">
          <a class="backLink" href="{{ backHref or '/' }}">← {{ backLabel or 'Back' }}</a>
          <div class="ctaRow">
            {% block ctas %}{% endblock %}
          </div>
        </div>
      </header>
    {% endif %}

    {% block content %}
      {{ content | safe }}
    {% endblock %}

    {# Terminal connect block (canonical, used site-wide) #}
    {% if (not minimalShell) and (pageId not in ["tool-demo-embed","article"]) %}

      <section class="exploreNext" aria-label="Connect">
        <div class="panel panel--cool">
          <h2 class="section-title">Let's Connect</h2>
          <p class="section-sub">
            Open to roles in People Analytics, Talent Intelligence, People Ops, and Recruiting Operations — especially teams building internal AI capabilities.
          </p>

          <div class="exploreNext__actions centerRow">
            <a class="btn" href="mailto:dianewilkinson510@gmail.com">📩 Email Diane</a>
            <a class="btn" href="https://www.linkedin.com/in/dianewilkinson" target="_blank" rel="noopener">🔗 Connect on LinkedIn</a>
            <a class="btn" href="/contact/scheduler/">📅 Schedule 15 min Intro</a>
          </div>
        </div>
      </section>
    {% endif %}

  </main>

  {% if not minimalShell %}
    <footer class="site-footer">
      <div class="site-footer__row">
        <div>Based in the San Francisco Bay Area · dianewilkinson510@gmail.com</div>
      </div>
    </footer>
  {% endif %}
</body>
</html>
