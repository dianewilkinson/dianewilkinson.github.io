<script>
  const $ = (id) => document.getElementById(id);

  const SCENARIOS = {
    base:   { note: "Base: typical conversion rates", offerAccept: 0.85, finalToOffer: 0.25, hmToFinal: 0.75, riToHm: 0.50, appToRi: 0.10 },
    tight:  { note: "Capacity constrained: weaker pass-through", offerAccept: 0.80, finalToOffer: 0.20, hmToFinal: 0.60, riToHm: 0.40, appToRi: 0.08 },
    improve:{ note: "Improve CVRs: better calibration + structured screening", offerAccept: 0.88, finalToOffer: 0.30, hmToFinal: 0.80, riToHm: 0.55, appToRi: 0.12 }
  };

  function clamp01(x){
    if (!Number.isFinite(x)) return NaN;
    return Math.max(0, Math.min(1, x));
  }
  function ceilInt(x){
    if (!Number.isFinite(x)) return NaN;
    return Math.ceil(x);
  }

  function parseDateInput(v){
    if (!v) return null;
    const d = new Date(v + "T00:00:00");
    return Number.isNaN(d.getTime()) ? null : d;
  }

  function addDays(d, days){
    const out = new Date(d.getTime());
    out.setDate(out.getDate() + days);
    return out;
  }

  // Monday-based week start (sheet-style)
  function startOfWeek(d){
    const out = new Date(d.getTime());
    const day = out.getDay(); // 0=Sun
    const diffToMon = (day === 0 ? -6 : 1) - day;
    out.setDate(out.getDate() + diffToMon);
    out.setHours(0,0,0,0);
    return out;
  }

  // "Feb-27" style (no weekday, no wrapping)
  function weekKey(d){
    const m = d.toLocaleDateString(undefined, { month:"short" });
    const day = d.toLocaleDateString(undefined, { day:"2-digit" });
    return `${m}-${day}`;
  }

  function diffWeeks(a, b){
    const ms = startOfWeek(b).getTime() - startOfWeek(a).getTime();
    return Math.round(ms / (7 * 24 * 60 * 60 * 1000));
  }

  function fmt(x, decimals = 1){
    if (!Number.isFinite(x)) return "—";
    return x.toLocaleString(undefined, { maximumFractionDigits: decimals });
  }

  function readInputs(){
    const reqOpenDate = parseDateInput($("reqOpenDate").value);
    const newHireStartDate = parseDateInput($("newHireStartDate").value);

    const weeksSourcingBeforeInterviews = parseInt($("weeksSourcingBeforeInterviews").value, 10);
    const weeksOfferToAccept = parseInt($("weeksOfferToAccept").value, 10);
    const weeksAcceptanceToStart = parseInt($("weeksAcceptanceToStart").value, 10);
    const hires = parseInt($("hires").value, 10);

    const offerAccept = clamp01(parseFloat($("offerAccept").value));
    const finalToOffer = clamp01(parseFloat($("finalToOffer").value));
    const hmToFinal = clamp01(parseFloat($("hmToFinal").value));
    const riToHm = clamp01(parseFloat($("riToHm").value));
    const appToRi = clamp01(parseFloat($("appToRi").value));

    return {
      reqOpenDate,
      newHireStartDate,
      weeksSourcingBeforeInterviews,
      weeksOfferToAccept,
      weeksAcceptanceToStart,
      hires,
      offerAccept,
      finalToOffer,
      hmToFinal,
      riToHm,
      appToRi
    };
  }

  function validate(inp){
    if (!inp.reqOpenDate) return "Requisition Open Date is required.";
    if (!inp.newHireStartDate) return "New Hire Start Date is required.";
    if (inp.newHireStartDate.getTime() <= inp.reqOpenDate.getTime()) return "New Hire Start Date must be after Req Open Date.";

    const ints = [
      ["# Weeks Sourcing Before Interviews", inp.weeksSourcingBeforeInterviews],
      ["# Weeks Offer to Accept", inp.weeksOfferToAccept],
      ["# Weeks Acceptance to Start", inp.weeksAcceptanceToStart]
    ];
    for (const [name, v] of ints){
      if (!Number.isFinite(v) || v < 0) return `${name} must be 0 or more.`;
    }

    if (!Number.isFinite(inp.hires) || inp.hires <= 0) return "Target hires must be >= 1.";

    const rates = [
      ["Offer accept rate", inp.offerAccept],
      ["Final → Offer", inp.finalToOffer],
      ["HM → Final", inp.hmToFinal],
      ["Recruiter Interview → HM", inp.riToHm],
      ["App → Recruiter Interview", inp.appToRi]
    ];
    for (const [name, v] of rates){
      if (!Number.isFinite(v)) return `${name} must be a number between 0 and 1.`;
      if (v <= 0) return `${name} must be > 0 (or the funnel becomes infinite).`;
      if (v > 1) return `${name} must be <= 1.`;
    }

    return null;
  }

  // Back-solve totals from hires (sheet-style)
  function calcTotals(inp){
    const hires = inp.hires;
    const offersNeeded = hires / inp.offerAccept;
    const finalsNeeded = offersNeeded / inp.finalToOffer;
    const hmNeeded = finalsNeeded / inp.hmToFinal;
    const riNeeded = hmNeeded / inp.riToHm;
    const appsNeeded = riNeeded / inp.appToRi;

    return {
      hires: hires,
      offers: ceilInt(offersNeeded),
      finals: ceilInt(finalsNeeded),
      hm: ceilInt(hmNeeded),
      ri: ceilInt(riNeeded),
      apps: ceilInt(appsNeeded)
    };
  }

  /**
   * Sheet-aligned calendar logic:
   * - Hire-by is ACCEPTS: newHireStartDate minus (Acceptance-to-Start weeks)
   * - TTF is weeks from Req Open WEEK (Mon) to Hire-by WEEK (Mon), inclusive => diff + 1
   * - Active interview weeks are the "RI run" weeks:
   *     activeInterviewWeeks = TTF - weeksOfferToAccept - 3
   *   (the -3 is the staged dependency lag from RI → HM → Final → Offer in the sheet model)
   */
  function computeCalendar(inp){
    const reqW = startOfWeek(inp.reqOpenDate);

    const hireByDate = addDays(inp.newHireStartDate, -7 * inp.weeksAcceptanceToStart);
    const hireByW = startOfWeek(hireByDate);

    const ttfWeeks = Math.max(1, diffWeeks(reqW, hireByW) + 1);

    const offerLag = Math.max(0, inp.weeksOfferToAccept);
    const activeInterviewWeeks = Math.max(1, ttfWeeks - offerLag - 3);

    // Starts (staggered)
    const riStartW = addDays(reqW, 7 * inp.weeksSourcingBeforeInterviews);
    const hmStartW = addDays(riStartW, 7 * 1);
    const finalStartW = addDays(riStartW, 7 * 2);

    // Offer start in the sheet model occurs 4 weeks after RI start (gives the sheet’s spacing + debrief buffer),
    // and still respects "offers start after finals".
    const offerStartW = addDays(riStartW, 7 * 4);

    // Acceptance week is hire-by week (accepts).
    const acceptW = hireByW;

    return {
      reqW,
      hireByDate,
      hireByW,
      ttfWeeks,
      activeInterviewWeeks,
      riStartW,
      hmStartW,
      finalStartW,
      offerStartW,
      acceptW
    };
  }

  // Accumulator distribution to match sheet behavior (sparse 1s when rate < 1)
  function distribute(total, lenWeeks){
    const out = Array.from({ length: lenWeeks }, () => 0);
    if (lenWeeks <= 0) return out;
    if (!Number.isFinite(total) || total <= 0) return out;

    const rate = total / lenWeeks;
    let acc = 0;
    for (let i = 0; i < lenWeeks; i++){
      const prev = Math.floor(acc);
      acc += rate;
      const now = Math.floor(acc);
      out[i] = Math.max(0, now - prev);
    }

    // Fix rounding drift: force sum == total by adding/subtracting from the end (sheet-like correction)
    let sum = out.reduce((a,b) => a+b, 0);
    while (sum < total){
      out[out.length - 1] += 1;
      sum += 1;
    }
    while (sum > total){
      // remove from the last positive bucket
      for (let i = out.length - 1; i >= 0 && sum > total; i--){
        if (out[i] > 0){
          out[i] -= 1;
          sum -= 1;
        }
      }
      if (sum > total) break;
    }

    return out;
  }

  /**
   * Build week-by-week planner windows (your rule):
   * - RI runs for activeInterviewWeeks.
   * - Apps start immediately (req open week) and continue through interviewing,
   *   but STOP one week before the final RI week (feed-next-week).
   *   Apps weeks count:
   *     appsWeeks = riWeeks - 1 + weeksSourcingBeforeInterviews
   *   (exactly what you stated)
   * - HM starts 1 week after RI, Finals start 2 weeks after RI.
   * - Offers start at offerStartW and run up to acceptance week.
   * - We do NOT plan beyond acceptance (no post-acceptance weeks).
   */
  function buildPlanner(inp, cal, totals){
    const riWeeks = cal.activeInterviewWeeks;
    const appsWeeks = Math.max(0, riWeeks - 1 + inp.weeksSourcingBeforeInterviews);
    const hmWeeks = Math.max(0, riWeeks);
    const finalWeeks = Math.max(0, riWeeks);

    // Offer window: from offerStartW through acceptance week (inclusive)
    const offerWeeks = Math.max(1, diffWeeks(cal.offerStartW, addDays(cal.acceptW, 7)));

    // Week rows shown: include week 0 (one week before req open), then run through acceptance week
    const startW = addDays(cal.reqW, -7);
    const endW = cal.acceptW;
    const totalWeeksShown = Math.max(2, diffWeeks(startW, addDays(endW, 7))); // includes end week

    const weeks = Array.from({ length: totalWeeksShown }, (_, i) => addDays(startW, i * 7));

    // Stage weekly arrays (aligned to the shown week list)
    const appsArr = Array.from({ length: totalWeeksShown }, () => 0);
    const riArr = Array.from({ length: totalWeeksShown }, () => 0);
    const hmArr = Array.from({ length: totalWeeksShown }, () => 0);
    const finalArr = Array.from({ length: totalWeeksShown }, () => 0);
    const offerArr = Array.from({ length: totalWeeksShown }, () => 0);
    const hireArr = Array.from({ length: totalWeeksShown }, () => 0);

    // Indices in the shown table
    const idxReq = 1; // week 0 is row index 0, req open week is index 1
    const idxRiStart = idxReq + inp.weeksSourcingBeforeInterviews;
    const idxHmStart = idxRiStart + 1;
    const idxFinalStart = idxRiStart + 2;

    // Offer start index: locate offerStartW in weeks list
    const idxOfferStart = weeks.findIndex(w => startOfWeek(w).getTime() === startOfWeek(cal.offerStartW).getTime());
    const idxAccept = weeks.findIndex(w => startOfWeek(w).getTime() === startOfWeek(cal.acceptW).getTime());

    // Distribute totals over their windows (sheet-like)
    const appsDist = distribute(totals.apps, appsWeeks);
    const riDist = distribute(totals.ri, riWeeks);
    const hmDist = distribute(totals.hm, hmWeeks);
    const finalDist = distribute(totals.finals, finalWeeks);
    const offerDist = distribute(totals.offers, offerWeeks);

    // Apps start at req open week, run appsWeeks
    for (let i = 0; i < appsWeeks; i++){
      const idx = idxReq + i;
      if (idx >= 0 && idx < appsArr.length) appsArr[idx] = appsDist[i];
    }

    // RI start at idxRiStart, run riWeeks
    for (let i = 0; i < riWeeks; i++){
      const idx = idxRiStart + i;
      if (idx >= 0 && idx < riArr.length) riArr[idx] = riDist[i];
    }

    // HM start at idxHmStart, run hmWeeks
    for (let i = 0; i < hmWeeks; i++){
      const idx = idxHmStart + i;
      if (idx >= 0 && idx < hmArr.length) hmArr[idx] = hmDist[i];
    }

    // Final start at idxFinalStart, run finalWeeks
    for (let i = 0; i < finalWeeks; i++){
      const idx = idxFinalStart + i;
      if (idx >= 0 && idx < finalArr.length) finalArr[idx] = finalDist[i];
    }

    // Offers start at idxOfferStart (calculated), run offerWeeks (bounded)
    if (idxOfferStart >= 0){
      for (let i = 0; i < offerWeeks; i++){
        const idx = idxOfferStart + i;
        if (idx >= 0 && idx < offerArr.length) offerArr[idx] = offerDist[i];
      }
    }

    // Hires distribution is not planned post-accept in this version (per your instruction),
    // but we still show total hires in header. Keep hire column blank.
    // If you later want the sheet’s hire placement logic, we can wire it to starts after accepts.

    // Per-week “headline rates” like the sheet row:
    const appsPerWk = appsWeeks > 0 ? (totals.apps / appsWeeks) : NaN;
    const riPerWk = riWeeks > 0 ? (totals.ri / riWeeks) : NaN;
    const hmPerWk = hmWeeks > 0 ? (totals.hm / hmWeeks) : NaN;
    const finalPerWk = finalWeeks > 0 ? (totals.finals / finalWeeks) : NaN;
    const offersPerWk = offerWeeks > 0 ? (totals.offers / offerWeeks) : NaN;
    const hiresPerWk = cal.activeInterviewWeeks > 0 ? (totals.hires / cal.activeInterviewWeeks) : NaN;

    return {
      weeks,
      idxReq,
      idxRiStart,
      idxOfferStart,
      idxAccept,
      series: { appsArr, riArr, hmArr, finalArr, offerArr, hireArr },
      rates: { appsPerWk, riPerWk, hmPerWk, finalPerWk, offersPerWk, hiresPerWk }
    };
  }

  function phaseForWeek(wkStart, cal){
    const t = startOfWeek(wkStart).getTime();
    const tRi = startOfWeek(cal.riStartW).getTime();
    const tOffer = startOfWeek(cal.offerStartW).getTime();
    const tAccept = startOfWeek(cal.acceptW).getTime();

    if (t < tRi) return "Sourcing";
    if (t >= tRi && t < tOffer) return "Interviews";
    if (t >= tOffer && t <= tAccept) return "Offer";
    return "";
  }

  function renderAll(inp, cal, totals, plan){
    // Funnel totals
    $("totApps").textContent = totals.apps.toLocaleString();
    $("totRi").textContent = totals.ri.toLocaleString();
    $("totHm").textContent = totals.hm.toLocaleString();
    $("totFinal").textContent = totals.finals.toLocaleString();
    $("totOffers").textContent = totals.offers.toLocaleString();
    $("totHires").textContent = totals.hires.toLocaleString();

    // Outputs
    $("outActiveInterviewWeeks").textContent = cal.activeInterviewWeeks.toLocaleString();
    $("outHireBy").textContent = weekKey(cal.hireByW);
    $("outOfferStart").textContent = weekKey(cal.offerStartW);
    $("outHireStart").textContent = weekKey(startOfWeek(inp.newHireStartDate));

    $("outReqOpenWeek").textContent = weekKey(cal.reqW);
    $("outRiStartWeek").textContent = weekKey(cal.riStartW);
    $("outAcceptWeek").textContent = weekKey(cal.acceptW);

    $("outTimeToFill").textContent = cal.ttfWeeks.toLocaleString();

    const ratio = totals.apps / inp.hires;
    $("outRatio").textContent = fmt(ratio, 1);

    // Planner header boxes
    $("boxTTF").textContent = cal.ttfWeeks.toLocaleString();
    $("boxWeekStart").textContent = weekKey(cal.reqW);

    $("boxAppsTotal").textContent = totals.apps.toLocaleString();
    $("boxRiTotal").textContent = totals.ri.toLocaleString();
    $("boxHmTotal").textContent = totals.hm.toLocaleString();
    $("boxFinalTotal").textContent = totals.finals.toLocaleString();
    $("boxOffersTotal").textContent = totals.offers.toLocaleString();
    $("boxHiresTotal").textContent = totals.hires.toLocaleString();
    $("boxPhaseLabel").textContent = "Sourcing / Interviews / Offer";

    // Planner per-week labels (no “Needed” repetition)
    $("wkApps").textContent = fmt(plan.rates.appsPerWk, 1);
    $("wkRi").textContent = fmt(plan.rates.riPerWk, 1);
    $("wkHm").textContent = fmt(plan.rates.hmPerWk, 1);
    $("wkFinal").textContent = fmt(plan.rates.finalPerWk, 1);
    $("wkOffers").textContent = fmt(plan.rates.offersPerWk, 1);
    $("wkHires").textContent = fmt(plan.rates.hiresPerWk, 1);

    // Constraint text (keep it simple + correct)
    const top = [
      ["Apps", plan.rates.appsPerWk],
      ["RI", plan.rates.riPerWk],
      ["HM", plan.rates.hmPerWk],
      ["Final", plan.rates.finalPerWk],
      ["Offers", plan.rates.offersPerWk],
    ].filter(x => Number.isFinite(x[1])).sort((a,b)=>b[1]-a[1])[0];

    const msg = top ? `Constraint signal: ~${fmt(top[1],1)} ${top[0]} per week.` : "Enter values and click Calculate.";
    $("constraintTextFunnel").textContent = msg;
    $("constraintTextPlanner").textContent = msg;

    // Planner table body
    const tbody = $("plannerBody");
    tbody.innerHTML = "";

    for (let i = 0; i < plan.weeks.length; i++){
      const wkStart = plan.weeks[i];
      const weekNum = i; // matches sheet: week 0 is the row before req open
      const apps = plan.series.appsArr[i] ? plan.series.appsArr[i].toLocaleString() : "";
      const ri = plan.series.riArr[i] ? plan.series.riArr[i].toLocaleString() : "";
      const hm = plan.series.hmArr[i] ? plan.series.hmArr[i].toLocaleString() : "";
      const fin = plan.series.finalArr[i] ? plan.series.finalArr[i].toLocaleString() : "";
      const off = plan.series.offerArr[i] ? plan.series.offerArr[i].toLocaleString() : "";
      const hir = ""; // per your instruction (no post-accept planning)

      const phase = phaseForWeek(wkStart, cal);

      const tr = document.createElement("tr");
      tr.innerHTML = `
        <td>${weekNum}</td>
        <td>${weekKey(wkStart)}</td>
        <td>${apps}</td>
        <td>${ri}</td>
        <td>${hm}</td>
        <td>${fin}</td>
        <td>${off}</td>
        <td>${hir}</td>
        <td class="muted">${phase}</td>
      `;
      tbody.appendChild(tr);
    }
  }

  function applyScenario(key){
    const s = SCENARIOS[key] || SCENARIOS.base;
    $("offerAccept").value = s.offerAccept;
    $("finalToOffer").value = s.finalToOffer;
    $("hmToFinal").value = s.hmToFinal;
    $("riToHm").value = s.riToHm;
    $("appToRi").value = s.appToRi;

    const note = $("scenarioNote");
    if (note) note.textContent = s.note;

    onCalculate();
  }

  function setDefaultDates(){
    const today = new Date();
    today.setHours(0,0,0,0);
    const req = startOfWeek(today);
    const start = addDays(req, 7 * 20);
    $("reqOpenDate").value = req.toISOString().slice(0,10);
    $("newHireStartDate").value = start.toISOString().slice(0,10);
  }

  function onCalculate(){
    $("error").textContent = "";

    const inp = readInputs();
    const err = validate(inp);
    if (err){
      $("error").textContent = err;
      return;
    }

    const totals = calcTotals(inp);
    const cal = computeCalendar(inp);
    const plan = buildPlanner(inp, cal, totals);

    renderAll(inp, cal, totals, plan);
  }

  function onReset(){
    setDefaultDates();
    $("weeksSourcingBeforeInterviews").value = 1;
    $("weeksOfferToAccept").value = 1;
    $("weeksAcceptanceToStart").value = 3;
    $("hires").value = 4;

    $("error").textContent = "";
    $("constraintTextFunnel").textContent = "Enter values and click Calculate.";
    $("constraintTextPlanner").textContent = "Enter values and click Calculate.";

    applyScenario("base");
  }

  document.querySelectorAll("[data-scn]").forEach(btn => {
    btn.addEventListener("click", () => applyScenario(btn.dataset.scn));
  });

  $("calcBtn").addEventListener("click", onCalculate);
  $("resetBtn").addEventListener("click", onReset);

  [
    "reqOpenDate","newHireStartDate",
    "weeksSourcingBeforeInterviews","weeksOfferToAccept","weeksAcceptanceToStart",
    "hires","offerAccept","finalToOffer","hmToFinal","riToHm","appToRi"
  ].forEach(id => $(id).addEventListener("input", () => {
    window.clearTimeout(window.__t);
    window.__t = window.setTimeout(onCalculate, 180);
  }));

  setDefaultDates();
  applyScenario("base");
</script>