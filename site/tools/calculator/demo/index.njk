<style>
/* ===== tool-demo page-scoped styles ===== */

/* Flip grid so inputs (left) are narrower than the funnel (right) */
body[data-page="tool-demo"] .grid2 {
  grid-template-columns: 0.82fr 1.18fr;
}

/* ---- Field rows (Inputs card) ---- */
.field-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 14px;
  padding: 9px 0;
  border-bottom: 1px solid var(--border);
  font-size: 14px;
}
.field-row:last-child { border-bottom: none; }
.field-label { color: var(--muted); flex: 1; line-height: 1.35; }
.field-input {
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 5px 9px;
  font-size: 14px;
  width: 116px;
  text-align: right;
  background: #fff;
  color: var(--text);
  flex-shrink: 0;
}
.field-input:focus {
  outline: none;
  border-color: var(--accent);
  box-shadow: 0 0 0 3px rgba(79,70,229,.10);
}
.field-input--date { text-align: left; }

/* ---- Funnel stage rows ---- */
.f-stage {
  position: relative;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 9px 10px;
  border-radius: 10px;
  overflow: hidden;
}
.f-stage__bar {
  position: absolute;
  left: 0; top: 0; bottom: 0;
  background: linear-gradient(90deg, rgba(79,70,229,.13), rgba(167,139,250,.07));
  border-radius: 10px;
  pointer-events: none;
  transition: width 0.35s ease;
  width: 0%;
}
.f-stage__num {
  font-size: 17px;
  font-weight: 900;
  color: var(--accent);
  min-width: 50px;
  text-align: right;
  position: relative;
  letter-spacing: -.02em;
}
.f-stage__name {
  font-size: 13px;
  font-weight: 700;
  color: var(--text);
  flex: 1;
  position: relative;
  white-space: nowrap;
}
.f-stage__cvr {
  display: flex;
  align-items: center;
  gap: 5px;
  position: relative;
  flex-shrink: 0;
}
.f-stage__cvr-label {
  font-size: 12px;
  color: var(--muted2);
  white-space: nowrap;
}
.f-cvr-input {
  border: 1px solid rgba(79,70,229,.28);
  border-radius: 7px;
  padding: 4px 6px;
  font-size: 13px;
  width: 46px;
  text-align: right;
  background: rgba(79,70,229,.04);
  color: var(--text);
}
.f-cvr-input:focus {
  outline: none;
  border-color: var(--accent);
  box-shadow: 0 0 0 2px rgba(79,70,229,.10);
}
.f-pct { font-size: 12px; color: var(--muted2); }

/* Arrow connector between funnel stages */
.f-connector {
  text-align: center;
  color: var(--muted2);
  font-size: 12px;
  padding: 1px 0;
  opacity: 0.5;
}

/* ---- Hires target row (bottom of funnel, no CVR) ---- */
.f-stage--hires .f-stage__bar {
  background: linear-gradient(90deg, rgba(99,102,241,.22), rgba(167,139,250,.14));
}
.f-stage--hires .f-stage__num { color: #4338ca; }

/* ---- Output stat boxes ---- */
.stat-box {
  border: 1px solid var(--border);
  background: rgba(255,255,255,.78);
  border-radius: 14px;
  padding: 13px 16px;
  display: flex;
  flex-direction: column;
  gap: 3px;
}
.stat-box__label {
  font-size: 12px;
  color: var(--muted2);
  line-height: 1.3;
}
.stat-box__value {
  font-size: 22px;
  font-weight: 900;
  color: var(--text);
  letter-spacing: -.025em;
  line-height: 1.1;
}
.stat-box--accent .stat-box__value { color: var(--accent); }

/* ---- Planner table ---- */
.planner-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 13px;
}
.planner-table th {
  background: rgba(79,70,229,.06);
  border: 1px solid var(--border);
  padding: 7px 10px;
  font-size: 12px;
  font-weight: 700;
  color: var(--muted2);
  text-align: center;
  line-height: 1.35;
}
.planner-table td {
  border: 1px solid var(--border);
  padding: 5px 10px;
  text-align: center;
  color: var(--text);
}
.planner-table .totals-row td {
  font-weight: 800;
  color: var(--accent);
  background: rgba(79,70,229,.05);
  font-size: 14px;
}
.planner-table .week-row td { color: var(--muted); }
.planner-table .week-row td:first-child,
.planner-table .week-row td:nth-child(2) { color: var(--text); font-weight: 600; }
</style>


