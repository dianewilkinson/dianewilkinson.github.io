<section class="panel panel--cool">
  <div class="panelInner">
    <div class="ctaRow ctaRow--left">
      <button class="btnGhost" type="button" data-scn="base">Base</button>
      <button class="btnGhost" type="button" data-scn="tight">Capacity constrained</button>
      <button class="btnGhost" type="button" data-scn="improve">Improve CVRs</button>
      <span class="muted" id="scenarioNote"></span>
    </div>
  </div>
</section>

<section class="grid2">
  <!-- INPUTS -->
  <div class="card">
    <h2 class="section-title">Inputs</h2>
    <p class="section-sub">Start dates + admin timing assumptions.</p>

    <label>
      Requisition Open Date
      <input id="reqOpenDate" type="date" />
    </label>

    <div class="rule"></div>

    <label>
      New Hire Start Date
      <input id="newHireStartDate" type="date" />
    </label>

    <div class="rule"></div>

    <label>
      # Weeks Sourcing Before Interviews
      <input id="weeksSourcingBeforeInterviews" type="number" min="0" step="1" value="1" />
    </label>

    <div class="rule"></div>

    <label>
      # Weeks Offer to Accept
      <input id="weeksOfferToAccept" type="number" min="0" step="1" value="1" />
    </label>

    <div class="rule"></div>

    <label>
      # Weeks Acceptance to Start
      <input id="weeksAcceptanceToStart" type="number" min="0" step="1" value="3" />
    </label>

    <div class="rule"></div>

    <label>
      Target hires
      <input id="hires" type="number" min="1" step="1" value="4" />
    </label>

    <div class="rule"></div>

    <div class="ctaRow ctaRow--left">
      <button class="btn primary" id="calcBtn" type="button">Calculate</button>
      <button class="btnGhost" id="resetBtn" type="button">Reset</button>
      <span id="error" class="muted"></span>
    </div>
  </div>

  <!-- FUNNEL INPUTS -->
  <div class="card">
    <h2 class="section-title">Funnel</h2>
    <p class="section-sub">Stage conversions (0–1). Back-solves from hires.</p>

    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th align="left">Stage</th>
            <th align="left">Conversion</th>
            <th align="left">Rate (0–1)</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Applications</td>
            <td>App → Recruiter Interview</td>
            <td><input id="appToRi" type="number" min="0" max="1" step="0.01" value="0.10" /></td>
          </tr>
          <tr>
            <td>Recruiter Interview</td>
            <td>Recruiter Interview → HM</td>
            <td><input id="riToHm" type="number" min="0" max="1" step="0.01" value="0.50" /></td>
          </tr>
          <tr>
            <td>HM Interview</td>
            <td>HM → Final</td>
            <td><input id="hmToFinal" type="number" min="0" max="1" step="0.01" value="0.75" /></td>
          </tr>
          <tr>
            <td>Final</td>
            <td>Final → Offer</td>
            <td><input id="finalToOffer" type="number" min="0" max="1" step="0.01" value="0.25" /></td>
          </tr>
          <tr>
            <td>Offer</td>
            <td>Offer Accept Rate</td>
            <td><input id="offerAccept" type="number" min="0" max="1" step="0.01" value="0.85" /></td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="callout">
      Weekly timing is staggered by dependency: Apps (sourcing) → RI → HM → Final → Offer.
      Offers are planned over the last half of active interview weeks.
    </div>

    <p class="muted" id="constraintText">Enter values and click Calculate.</p>
  </div>
</section>

<!-- OUTPUTS ALIGNED WITH PLANNER COLUMNS -->
<section class="full">
  <h2 class="section-title">Weekly Time-to-Fill Planner</h2>
  <p class="section-sub">Outputs are embedded in the header so they align above the planner columns (like the sheet).</p>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th align="left">
            Week
            <div class="small">TTF (wks): <b id="outTimeToFill">—</b></div>
            <div class="small">Active interview wks: <b id="outActiveInterviewWeeks">—</b></div>
          </th>
          <th align="left">
            Dates
            <div class="small">Req open week: <b id="outReqOpenWeek">—</b></div>
            <div class="small">Start week: <b id="outStartWeek">—</b></div>
          </th>
          <th align="left">
            Phase
            <div class="small">Offer start week: <b id="outOfferStartWeek">—</b></div>
            <div class="small">Acceptance week: <b id="outAcceptWeek">—</b></div>
          </th>
          <th align="left">
            Apps
            <div class="small">Total: <b id="outApps">—</b></div>
            <div class="small">/wk: <b id="outAppsPerWk">—</b></div>
          </th>
          <th align="left">
            RI
            <div class="small">Total: <b id="outRi">—</b></div>
            <div class="small">/wk: <b id="outRiPerWk">—</b></div>
          </th>
          <th align="left">
            HM
            <div class="small">Total: <b id="outHm">—</b></div>
            <div class="small">/wk: <b id="outHmPerWk">—</b></div>
          </th>
          <th align="left">
            Final
            <div class="small">Total: <b id="outFinal">—</b></div>
            <div class="small">/wk: <b id="outFinalPerWk">—</b></div>
          </th>
          <th align="left">
            Offer
            <div class="small">Total: <b id="outOffers">—</b></div>
            <div class="small">/wk: <b id="outOffersPerWk">—</b></div>
          </th>
          <th align="left">
            Notes
            <div class="small">App → 1 hire: <b id="outRatio">—</b></div>
          </th>
        </tr>
      </thead>
      <tbody id="plannerBody">
        <tr>
          <td colspan="9" class="muted">Enter values and click Calculate.</td>
        </tr>
      </tbody>
    </table>
  </div>
</section>

<script>
  const $ = (id) => document.getElementById(id);

  const SCENARIOS = {
    base: { note: "Base: typical conversion rates", offerAccept: 0.85, finalToOffer: 0.25, hmToFinal: 0.75, riToHm: 0.50, appToRi: 0.10 },
    tight: { note: "Capacity constrained: weaker pass-through", offerAccept: 0.80, finalToOffer: 0.20, hmToFinal: 0.60, riToHm: 0.40, appToRi: 0.08 },
    improve: { note: "Improve CVRs: better calibration + structured screening", offerAccept: 0.88, finalToOffer: 0.30, hmToFinal: 0.80, riToHm: 0.55, appToRi: 0.12 }
  };

  function clamp01(x) {
    if (!Number.isFinite(x)) return NaN;
    return Math.max(0, Math.min(1, x));
  }

  function safeCeil(x) {
    if (!Number.isFinite(x)) return NaN;
    return Math.ceil(x);
  }

  function parseDateInput(v) {
    if (!v) return null;
    const d = new Date(v + "T00:00:00");
    return Number.isNaN(d.getTime()) ? null : d;
  }

  function addDays(d, days) {
    const out = new Date(d.getTime());
    out.setDate(out.getDate() + days);
    return out;
  }

  function startOfWeek(d) {
    const out = new Date(d.getTime());
    const day = out.getDay(); // 0=Sun
    const diffToMon = (day === 0 ? -6 : 1) - day;
    out.setDate(out.getDate() + diffToMon);
    out.setHours(0,0,0,0);
    return out;
  }

  function weekKey(d) {
    return d.toLocaleDateString(undefined, { weekday: "short", month: "short", day: "2-digit" });
  }

  function diffWeeks(a, b) {
    const ms = startOfWeek(b).getTime() - startOfWeek(a).getTime();
    return Math.round(ms / (7 * 24 * 60 * 60 * 1000));
  }

  function fmt(x, decimals = 1) {
    if (!Number.isFinite(x)) return "—";
    return x.toLocaleString(undefined, { maximumFractionDigits: decimals });
  }

  function readInputs() {
    const reqOpenDate = parseDateInput($("reqOpenDate").value);
    const newHireStartDate = parseDateInput($("newHireStartDate").value);

    const weeksSourcingBeforeInterviews = parseInt($("weeksSourcingBeforeInterviews").value, 10);
    const weeksOfferToAccept = parseInt($("weeksOfferToAccept").value, 10);
    const weeksAcceptanceToStart = parseInt($("weeksAcceptanceToStart").value, 10);

    const hires = parseInt($("hires").value, 10);

    const offerAccept = clamp01(parseFloat($("offerAccept").value));
    const finalToOffer = clamp01(parseFloat($("finalToOffer").value));
    const hmToFinal = clamp01(parseFloat($("hmToFinal").value));
    const riToHm = clamp01(parseFloat($("riToHm").value));
    const appToRi = clamp01(parseFloat($("appToRi").value));

    return {
      reqOpenDate,
      newHireStartDate,
      weeksSourcingBeforeInterviews,
      weeksOfferToAccept,
      weeksAcceptanceToStart,
      hires,
      offerAccept,
      finalToOffer,
      hmToFinal,
      riToHm,
      appToRi
    };
  }

  function validate(inp) {
    if (!inp.reqOpenDate) return "Requisition Open Date is required.";
    if (!inp.newHireStartDate) return "New Hire Start Date is required.";
    if (inp.newHireStartDate.getTime() <= inp.reqOpenDate.getTime()) return "New Hire Start Date must be after Req Open Date.";

    const ints = [
      ["# Weeks Sourcing Before Interviews", inp.weeksSourcingBeforeInterviews],
      ["# Weeks Offer to Accept", inp.weeksOfferToAccept],
      ["# Weeks Acceptance to Start", inp.weeksAcceptanceToStart]
    ];
    for (const [name, v] of ints) {
      if (!Number.isFinite(v) || v < 0) return `${name} must be 0 or more.`;
    }

    if (!Number.isFinite(inp.hires) || inp.hires <= 0) return "Target hires must be >= 1.";

    const rates = [
      ["Offer accept rate", inp.offerAccept],
      ["Final → Offer", inp.finalToOffer],
      ["HM → Final", inp.hmToFinal],
      ["Recruiter Interview → HM", inp.riToHm],
      ["App → Recruiter Interview", inp.appToRi]
    ];
    for (const [name, v] of rates) {
      if (!Number.isFinite(v)) return `${name} must be a number between 0 and 1.`;
      if (v <= 0) return `${name} must be > 0 (or the funnel becomes infinite).`;
      if (v > 1) return `${name} must be <= 1.`;
    }

    return null;
  }

  function calcFunnel(inp) {
    const hires = inp.hires;

    const offersNeeded = hires / inp.offerAccept;
    const finalsNeeded = offersNeeded / inp.finalToOffer;
    const hmNeeded = finalsNeeded / inp.hmToFinal;
    const riNeeded = hmNeeded / inp.riToHm;
    const appsNeeded = riNeeded / inp.appToRi;

    return {
      offers: safeCeil(offersNeeded),
      finals: safeCeil(finalsNeeded),
      hm: safeCeil(hmNeeded),
      ri: safeCeil(riNeeded),
      apps: safeCeil(appsNeeded)
    };
  }

  // Forward, dependency-driven milestones (matches your sheet logic)
  function computeMilestones(inp) {
    const reqW = startOfWeek(inp.reqOpenDate);

    // Apps start in sourcing week
    const appsStartW = reqW;

    // Interviews start after sourcing lead time (0 allowed)
    const riStartW = addDays(reqW, 7 * inp.weeksSourcingBeforeInterviews);
    const hmStartW = addDays(riStartW, 7 * 1);
    const finalStartW = addDays(hmStartW, 7 * 1);

    // Offers begin week after finals
    const offerStartW = addDays(finalStartW, 7 * 1);

    // Admin lags forward from offer start
    const acceptW = addDays(offerStartW, 7 * inp.weeksOfferToAccept);
    const startW = addDays(acceptW, 7 * inp.weeksAcceptanceToStart);

    return { reqW, appsStartW, riStartW, hmStartW, finalStartW, offerStartW, acceptW, startW };
  }

  function buildPlan(inp, milestones, funnel) {
    const errors = [];

    // Offer lag window (offer → accept). Offers only appear here.
    const offerLagWeeks = Math.max(1, inp.weeksOfferToAccept);

    // Active interview weeks (this is the window we spread upstream work across)
    // Use RI start → Final start (inclusive) as the "interview window".
    const activeInterviewWeeks = Math.max(1, diffWeeks(milestones.riStartW, addDays(milestones.finalStartW, 7)));

    const appsPerWk = funnel.apps / activeInterviewWeeks;
    const riPerWk = funnel.ri / activeInterviewWeeks;
    const hmPerWk = funnel.hm / Math.max(1, activeInterviewWeeks - 1);
    const finalsPerWk = funnel.finals / Math.max(1, activeInterviewWeeks - 2);

    const offersPerWk = funnel.offers / offerLagWeeks;

    return {
      errors,
      activeInterviewWeeks,
      offerLagWeeks,
      appsStartW: milestones.appsStartW,
      rates: { appsPerWk, riPerWk, hmPerWk, finalsPerWk, offersPerWk }
    };
  }

  function renderHeader(inp, milestones, funnel, plan) {
    const ttf = diffWeeks(milestones.reqW, milestones.startW);

    $("outTimeToFill").textContent = ttf.toLocaleString();
    $("outActiveInterviewWeeks").textContent = (plan.activeInterviewWeeks || "—").toString();

    $("outReqOpenWeek").textContent = weekKey(milestones.reqW);
    $("outStartWeek").textContent = weekKey(milestones.startW);
    $("outOfferStartWeek").textContent = weekKey(milestones.offerStartW);
    $("outAcceptWeek").textContent = weekKey(milestones.acceptW);

    $("outApps").textContent = funnel.apps.toLocaleString();
    $("outRi").textContent = funnel.ri.toLocaleString();
    $("outHm").textContent = funnel.hm.toLocaleString();
    $("outFinal").textContent = funnel.finals.toLocaleString();
    $("outOffers").textContent = funnel.offers.toLocaleString();

    $("outAppsPerWk").textContent = fmt(plan.rates.appsPerWk, 1);
    $("outRiPerWk").textContent = fmt(plan.rates.riPerWk, 1);
    $("outHmPerWk").textContent = fmt(plan.rates.hmPerWk, 1);
    $("outFinalPerWk").textContent = fmt(plan.rates.finalsPerWk, 1);
    $("outOffersPerWk").textContent = fmt(plan.rates.offersPerWk, 1);

    const ratio = funnel.apps / inp.hires;
    $("outRatio").textContent = fmt(ratio, 2);

    const weekly = [
      ["Applications", plan.rates.appsPerWk],
      ["Recruiter interviews", plan.rates.riPerWk],
      ["HM interviews", plan.rates.hmPerWk],
      ["Final interviews", plan.rates.finalsPerWk],
      ["Offers", plan.rates.offersPerWk]
    ].sort((a,b) => b[1] - a[1]);

    const [topLabel, topVal] = weekly[0];
    $("constraintText").textContent = `Constraint signal: ~${fmt(topVal,1)} ${topLabel.toLowerCase()} per week (planned window).`;
  }

  function buildPlanner(inp, milestones, plan) {
    const tbody = $("plannerBody");
    tbody.innerHTML = "";

    const start = milestones.reqW;
    const end = milestones.startW;
    const totalWeeks = Math.max(1, diffWeeks(start, addDays(end, 7)));

    function inWindow(wStart, stageStart, lenWeeks) {
      const d = diffWeeks(stageStart, wStart);
      return d >= 0 && d < lenWeeks;
    }

    for (let i = 0; i < totalWeeks; i++) {
      const wkStart = addDays(start, i * 7);
      const wkEnd = addDays(wkStart, 6);
      const wkMs = wkStart.getTime();

      let phase = "Sourcing";
      if (wkMs >= milestones.riStartW.getTime() && wkMs < milestones.offerStartW.getTime()) phase = "Interviews";
      if (wkMs >= milestones.offerStartW.getTime() && wkMs < milestones.acceptW.getTime()) phase = "Offer";
      if (wkMs >= milestones.acceptW.getTime() && wkMs < milestones.startW.getTime()) phase = "Pre-start";
      if (wkMs >= milestones.startW.getTime()) phase = "Start";

      // Apps run from req open through the start of interviews (sheet-style: sourcing includes apps)
      const appsLen = Math.max(1, diffWeeks(milestones.appsStartW, milestones.riStartW) + 1);
      const apps = inWindow(wkStart, milestones.appsStartW, appsLen) ? fmt(plan.rates.appsPerWk, 1) : "—";

      // RI/HM/Final staged
      const ri = inWindow(wkStart, milestones.riStartW, plan.activeInterviewWeeks) ? fmt(plan.rates.riPerWk, 1) : "—";
      const hm = inWindow(wkStart, milestones.hmStartW, Math.max(1, plan.activeInterviewWeeks - 1)) ? fmt(plan.rates.hmPerWk, 1) : "—";
      const finals = inWindow(wkStart, milestones.finalStartW, Math.max(1, plan.activeInterviewWeeks - 2)) ? fmt(plan.rates.finalsPerWk, 1) : "—";

      // Offers only during offer→accept lag weeks (never after acceptance)
      const offers = inWindow(wkStart, milestones.offerStartW, plan.offerLagWeeks) ? fmt(plan.rates.offersPerWk, 1) : "—";

      const notes = [];
      if (wkMs === milestones.reqW.getTime()) notes.push("Req open week");
      if (wkMs === milestones.appsStartW.getTime()) notes.push("Apps begin");
      if (wkMs === milestones.riStartW.getTime()) notes.push("RI begins");
      if (wkMs === milestones.hmStartW.getTime()) notes.push("HM begins");
      if (wkMs === milestones.finalStartW.getTime()) notes.push("Finals begin");
      if (wkMs === milestones.offerStartW.getTime()) notes.push("Offers begin");
      if (wkMs === milestones.acceptW.getTime()) notes.push("Acceptance week");
      if (wkMs === milestones.startW.getTime()) notes.push("Start week");

      const tr = document.createElement("tr");
      tr.innerHTML = `
        <td>${i + 1}</td>
        <td>${weekKey(wkStart)} – ${weekKey(wkEnd)}</td>
        <td>${phase}</td>
        <td>${apps}</td>
        <td>${ri}</td>
        <td>${hm}</td>
        <td>${finals}</td>
        <td>${offers}</td>
        <td>${notes.join(" · ") || "—"}</td>
      `;
      tbody.appendChild(tr);
    }
  }

  function applyScenario(key) {
    const s = SCENARIOS[key] || SCENARIOS.base;
    $("offerAccept").value = s.offerAccept;
    $("finalToOffer").value = s.finalToOffer;
    $("hmToFinal").value = s.hmToFinal;
    $("riToHm").value = s.riToHm;
    $("appToRi").value = s.appToRi;

    const note = $("scenarioNote");
    if (note) note.textContent = s.note;

    onCalculate();
  }

  function setDefaultDates() {
    const today = new Date();
    today.setHours(0,0,0,0);
    const req = startOfWeek(today);
    const start = addDays(req, 7 * 20);
    $("reqOpenDate").value = req.toISOString().slice(0,10);
    $("newHireStartDate").value = start.toISOString().slice(0,10);
  }

  function onCalculate() {
    $("error").textContent = "";
    const inp = readInputs();
    const err = validate(inp);
    if (err) { $("error").textContent = err; return; }

    const funnel = calcFunnel(inp);
    const milestones = computeMilestones(inp);
    const plan = buildPlan(inp, milestones, funnel);

    renderHeader(inp, milestones, funnel, plan);
    buildPlanner(inp, milestones, plan);
  }

  function onReset() {
    setDefaultDates();
    $("weeksSourcingBeforeInterviews").value = 1;
    $("weeksOfferToAccept").value = 1;
    $("weeksAcceptanceToStart").value = 3;
    $("hires").value = 4;
    $("error").textContent = "";
    $("constraintText").textContent = "Enter values and click Calculate.";
    applyScenario("base");
  }

  document.querySelectorAll("[data-scn]").forEach(btn => {
    btn.addEventListener("click", () => applyScenario(btn.dataset.scn));
  });

  $("calcBtn").addEventListener("click", onCalculate);
  $("resetBtn").addEventListener("click", onReset);

  [
    "reqOpenDate","newHireStartDate",
    "weeksSourcingBeforeInterviews","weeksOfferToAccept","weeksAcceptanceToStart",
    "hires","offerAccept","finalToOffer","hmToFinal","riToHm","appToRi"
  ].forEach(id => $(id).addEventListener("input", () => {
    window.clearTimeout(window.__t);
    window.__t = window.setTimeout(onCalculate, 180);
  }));

  setDefaultDates();
  applyScenario("base");
</script>