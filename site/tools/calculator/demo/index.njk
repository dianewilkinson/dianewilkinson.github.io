<!-- PLANNER FULL WIDTH -->
<section class="full">
  <h2 class="section-title">Weekly Time-to-Fill Planner</h2>
  <p class="section-sub">Full-width weekly plan with staggered stage timing and stage-by-stage stop points.</p>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th align="left">Week</th>
          <th align="left">Dates</th>
          <th align="left">Phase</th>
          <th align="left">Apps</th>
          <th align="left">RI</th>
          <th align="left">HM</th>
          <th align="left">Final</th>
          <th align="left">Offer</th>
          <th align="left">Notes</th>
        </tr>
      </thead>
      <tbody id="plannerBody">
        <tr>
          <td colspan="9" class="muted">Enter values and click Calculate.</td>
        </tr>
      </tbody>
    </table>
  </div>
</section>

<script>
  const $ = (id) => document.getElementById(id);

  const SCENARIOS = {
    base: {
      note: "Base: typical conversion rates",
      offerAccept: 0.85, finalToOffer: 0.25, hmToFinal: 0.75, riToHm: 0.50, appToRi: 0.10
    },
    tight: {
      note: "Capacity constrained: weaker pass-through",
      offerAccept: 0.80, finalToOffer: 0.20, hmToFinal: 0.60, riToHm: 0.40, appToRi: 0.08
    },
    improve: {
      note: "Improve CVRs: better calibration + structured screening",
      offerAccept: 0.88, finalToOffer: 0.30, hmToFinal: 0.80, riToHm: 0.55, appToRi: 0.12
    }
  };

  function clamp01(x) {
    if (!Number.isFinite(x)) return NaN;
    return Math.max(0, Math.min(1, x));
  }

  function safeCeil(x) {
    if (!Number.isFinite(x)) return NaN;
    return Math.ceil(x);
  }

  function parseDateInput(v) {
    if (!v) return null;
    const d = new Date(v + "T00:00:00");
    return Number.isNaN(d.getTime()) ? null : d;
  }

  function addDays(d, days) {
    const out = new Date(d.getTime());
    out.setDate(out.getDate() + days);
    return out;
  }

  function fmtDate(d) {
    if (!d) return "—";
    return d.toLocaleDateString(undefined, { year: "numeric", month: "short", day: "2-digit" });
  }

  function startOfWeek(d) {
    const out = new Date(d.getTime());
    const day = out.getDay(); // 0=Sun
    const diffToMon = (day === 0 ? -6 : 1) - day;
    out.setDate(out.getDate() + diffToMon);
    out.setHours(0,0,0,0);
    return out;
  }

  function weekKey(d) {
    return d.toLocaleDateString(undefined, { weekday: "short", month: "short", day: "2-digit" });
  }

  function diffWeeks(a, b) {
    const ms = startOfWeek(b).getTime() - startOfWeek(a).getTime();
    return Math.round(ms / (7 * 24 * 60 * 60 * 1000));
  }

  function fmt(x, decimals = 1) {
    if (!Number.isFinite(x)) return "—";
    return x.toLocaleString(undefined, { maximumFractionDigits: decimals });
  }

  function readInputs() {
    const reqOpenDate = parseDateInput($("reqOpenDate").value);
    const newHireStartDate = parseDateInput($("newHireStartDate").value);

    const weeksSourcingBeforeInterviews = parseInt($("weeksSourcingBeforeInterviews").value, 10);
    const weeksOfferToAccept = parseInt($("weeksOfferToAccept").value, 10);
    const weeksAcceptanceToStart = parseInt($("weeksAcceptanceToStart").value, 10);

    const hires = parseInt($("hires").value, 10);

    const offerAccept = clamp01(parseFloat($("offerAccept").value));
    const finalToOffer = clamp01(parseFloat($("finalToOffer").value));
    const hmToFinal = clamp01(parseFloat($("hmToFinal").value));
    const riToHm = clamp01(parseFloat($("riToHm").value));
    const appToRi = clamp01(parseFloat($("appToRi").value));

    return {
      reqOpenDate,
      newHireStartDate,
      weeksSourcingBeforeInterviews,
      weeksOfferToAccept,
      weeksAcceptanceToStart,
      hires,
      offerAccept,
      finalToOffer,
      hmToFinal,
      riToHm,
      appToRi
    };
  }

  function validate(inp) {
    if (!inp.reqOpenDate) return "Requisition Open Date is required.";
    if (!inp.newHireStartDate) return "New Hire Start Date is required.";
    if (inp.newHireStartDate.getTime() <= inp.reqOpenDate.getTime()) return "New Hire Start Date must be after Req Open Date.";

    const ints = [
      ["# Weeks Sourcing Before Interviews", inp.weeksSourcingBeforeInterviews],
      ["# Weeks Offer to Accept", inp.weeksOfferToAccept],
      ["# Weeks Acceptance to Start", inp.weeksAcceptanceToStart]
    ];
    for (const [name, v] of ints) {
      if (!Number.isFinite(v) || v < 0) return `${name} must be 0 or more.`;
    }

    if (!Number.isFinite(inp.hires) || inp.hires <= 0) return "Target hires must be >= 1.";

    const rates = [
      ["Offer accept rate", inp.offerAccept],
      ["Final → Offer", inp.finalToOffer],
      ["HM → Final", inp.hmToFinal],
      ["Recruiter Interview → HM", inp.riToHm],
      ["App → Recruiter Interview", inp.appToRi]
    ];
    for (const [name, v] of rates) {
      if (!Number.isFinite(v)) return `${name} must be a number between 0 and 1.`;
      if (v <= 0) return `${name} must be > 0 (or the funnel becomes infinite).`;
      if (v > 1) return `${name} must be <= 1.`;
    }

    return null;
  }

  function calcFunnel(inp) {
    const hires = inp.hires;

    const offersNeeded = hires / inp.offerAccept;
    const finalsNeeded = offersNeeded / inp.finalToOffer;
    const hmNeeded = finalsNeeded / inp.hmToFinal;
    const riNeeded = hmNeeded / inp.riToHm;
    const appsNeeded = riNeeded / inp.appToRi;

    return {
      offers: safeCeil(offersNeeded),
      finals: safeCeil(finalsNeeded),
      hm: safeCeil(hmNeeded),
      ri: safeCeil(riNeeded),
      apps: safeCeil(appsNeeded)
    };
  }

  function computeMilestones(inp) {
    const startW = startOfWeek(inp.newHireStartDate);

    // Acceptance week is delayed by Acceptance->Start weeks (THIS fixes your “start right after acceptance” issue)
    const acceptW = addDays(startW, -7 * inp.weeksAcceptanceToStart);

    // Offer start week is delayed by Offer->Accept weeks
    const offerW = addDays(acceptW, -7 * inp.weeksOfferToAccept);

    // Interview stage anchor: RI starts after sourcing lead time
    const reqW = startOfWeek(inp.reqOpenDate);
    const riStartW = addDays(reqW, 7 * inp.weeksSourcingBeforeInterviews);

    // Stagger rules you specified:
    // HM starts week after RI
    // Finals start week after HM
    // Offers start week after Finals
    const hmStartW = addDays(riStartW, 7 * 1);
    const finalStartW = addDays(riStartW, 7 * 2);
    const offerStartW_rule = addDays(riStartW, 7 * 3);

    // We must reconcile rule-based offer start with date-based offerW.
    // If date-based offerW is earlier than rule-based offer start, the configuration is impossible.
    const offerW_start = startOfWeek(offerW);
    const offerW_rule = startOfWeek(offerStartW_rule);

    return {
      reqW,
      riStartW,
      hmStartW,
      finalStartW,
      offerW_start,
      acceptW: startOfWeek(acceptW),
      startW,
      offerW_rule
    };
  }

  function buildPlan(inp, milestones, funnel) {
    const err = [];

    // “Week 1 sourcing has no apps”: apps start one week AFTER req open week.
    const appsStartW = addDays(milestones.reqW, 7 * 1);

    // Production window is the number of weeks we have from RI start up to the offer start week.
    // Within that window, stages stagger and stop in order.
    const productionWeeks = diffWeeks(milestones.riStartW, milestones.offerW_start);

    if (productionWeeks < 1) {
      err.push("Offer start week is not after interview start. Increase dates or reduce admin timing.");
    }
    // Ensure offer week isn’t earlier than the rule-based “offers start the week after finals”
    if (milestones.offerW_start.getTime() < milestones.offerW_rule.getTime()) {
      err.push("Offer start week is too early for the staged interview cadence (RI→HM→Final→Offer). Increase time between interview start and offer start.");
    }
    // Ensure apps start isn’t after RI start (otherwise no candidates)
    if (appsStartW.getTime() >= milestones.riStartW.getTime()) {
      err.push("Apps start week must be before RI start week. Increase sourcing lead time or move req open earlier.");
    }

    if (err.length) return { errors: err, productionWeeks: Math.max(1, productionWeeks), appsStartW };

    // Staggered weekly targets:
    // Apps run for N weeks starting appsStartW
    // RI runs for N weeks starting riStartW
    // HM runs for N weeks starting hmStartW
    // Final runs for N weeks starting finalStartW
    // Offer runs for N weeks starting offerW_start (and then accept/start sit after)
    const N = productionWeeks;

    const appsPerWk = funnel.apps / N;
    const riPerWk = funnel.ri / N;
    const hmPerWk = funnel.hm / N;
    const finalsPerWk = funnel.finals / N;
    const offersPerWk = funnel.offers / N;

    return {
      errors: [],
      N,
      appsStartW,
      rates: { appsPerWk, riPerWk, hmPerWk, finalsPerWk, offersPerWk }
    };
  }

  function renderOutputs(inp, milestones, funnel, plan) {
    const notes = [];

    const timeToFillWeeks = diffWeeks(milestones.reqW, milestones.acceptW);

    $("outActiveInterviewWeeks").textContent = (plan.N || "—").toString();
    $("outTimeToFill").textContent = timeToFillWeeks.toLocaleString();
    $("outHireByDate").textContent = fmtDate(addDays(milestones.acceptW, 0));

    $("outOfferStartWeek").textContent = weekKey(milestones.offerW_start);
    $("outAcceptStartWeek").textContent = weekKey(milestones.acceptW);
    $("outStartWeek").textContent = weekKey(milestones.startW);

    $("outApps").textContent = funnel.apps.toLocaleString();
    $("outRi").textContent = funnel.ri.toLocaleString();
    $("outHm").textContent = funnel.hm.toLocaleString();
    $("outFinal").textContent = funnel.finals.toLocaleString();
    $("outOffers").textContent = funnel.offers.toLocaleString();

    if (plan.errors && plan.errors.length) {
      $("outAppsPerWk").textContent = "—";
      $("outRiPerWk").textContent = "—";
      $("outHmPerWk").textContent = "—";
      $("outFinalPerWk").textContent = "—";
      $("outOffersPerWk").textContent = "—";
      $("outRatio").textContent = "—";
      $("outNotes").textContent = plan.errors.join(" ");
      $("constraintText").textContent = plan.errors.join(" ");
      return;
    }

    $("outAppsPerWk").textContent = `${fmt(plan.rates.appsPerWk, 1)} / week`;
    $("outRiPerWk").textContent = `${fmt(plan.rates.riPerWk, 1)} / week`;
    $("outHmPerWk").textContent = `${fmt(plan.rates.hmPerWk, 1)} / week`;
    $("outFinalPerWk").textContent = `${fmt(plan.rates.finalsPerWk, 1)} / week`;
    $("outOffersPerWk").textContent = `${fmt(plan.rates.offersPerWk, 1)} / week`;

    const ratio = funnel.apps / inp.hires;
    $("outRatio").textContent = fmt(ratio, 2);

    notes.push("Stages are staggered week-by-week (Apps → RI → HM → Final → Offer).");
    $("outNotes").textContent = notes.join(" ");

    const weekly = [
      ["Applications", plan.rates.appsPerWk],
      ["Recruiter interviews", plan.rates.riPerWk],
      ["HM interviews", plan.rates.hmPerWk],
      ["Final interviews", plan.rates.finalsPerWk],
      ["Offers", plan.rates.offersPerWk]
    ].sort((a,b) => b[1] - a[1]);

    const [topLabel, topVal] = weekly[0];
    $("constraintText").textContent = `Constraint signal: ~${fmt(topVal,1)} ${topLabel.toLowerCase()} per week during the active plan window.`;
  }

  function buildPlanner(inp, milestones, funnel, plan) {
    const tbody = $("plannerBody");
    tbody.innerHTML = "";

    if (plan.errors && plan.errors.length) {
      const tr = document.createElement("tr");
      tr.innerHTML = `<td colspan="9" class="muted">${plan.errors.join(" ")}</td>`;
      tbody.appendChild(tr);
      return;
    }

    // Show weeks from req open to start week (inclusive)
    const start = milestones.reqW;
    const end = milestones.startW;

    const totalWeeks = Math.max(1, diffWeeks(start, addDays(end, 7)) );

    const appsStart = plan.appsStartW;
    const riStart = milestones.riStartW;
    const hmStart = milestones.hmStartW;
    const finalStart = milestones.finalStartW;
    const offerStart = milestones.offerW_start;

    // Each stage runs N weeks, staggered, so they stop in order.
    const N = plan.N;

    function inWindow(wStart, stageStart, lenWeeks) {
      const d = diffWeeks(stageStart, wStart);
      return d >= 0 && d < lenWeeks;
    }

    for (let i = 0; i < totalWeeks; i++) {
      const wkStart = addDays(start, i * 7);
      const wkEnd = addDays(wkStart, 6);

      let phase = "Sourcing";
      const wkMs = wkStart.getTime();

      if (wkMs >= riStart.getTime() && wkMs < offerStart.getTime()) phase = "Interviews";
      if (wkMs >= offerStart.getTime() && wkMs < milestones.acceptW.getTime()) phase = "Offer";
      if (wkMs >= milestones.acceptW.getTime() && wkMs < milestones.startW.getTime()) phase = "Pre-start";
      if (wkMs >= milestones.startW.getTime()) phase = "Start";

      const apps = inWindow(wkStart, appsStart, N) ? fmt(plan.rates.appsPerWk, 1) : "—";
      const ri = inWindow(wkStart, riStart, N) ? fmt(plan.rates.riPerWk, 1) : "—";
      const hm = inWindow(wkStart, hmStart, N) ? fmt(plan.rates.hmPerWk, 1) : "—";
      const finals = inWindow(wkStart, finalStart, N) ? fmt(plan.rates.finalsPerWk, 1) : "—";
      const offers = inWindow(wkStart, offerStart, N) ? fmt(plan.rates.offersPerWk, 1) : "—";

      const notes = [];
      if (wkMs === start.getTime()) notes.push("Req open week");
      if (wkMs === appsStart.getTime()) notes.push("Apps begin");
      if (wkMs === riStart.getTime()) notes.push("RI begins");
      if (wkMs === hmStart.getTime()) notes.push("HM begins");
      if (wkMs === finalStart.getTime()) notes.push("Finals begin");
      if (wkMs === offerStart.getTime()) notes.push("Offers begin");
      if (wkMs === milestones.acceptW.getTime()) notes.push("Acceptance week");
      if (wkMs === milestones.startW.getTime()) notes.push("Start week");

      const tr = document.createElement("tr");
      tr.innerHTML = `
        <td>${i + 1}</td>
        <td>${weekKey(wkStart)} – ${weekKey(wkEnd)}</td>
        <td>${phase}</td>
        <td>${apps}</td>
        <td>${ri}</td>
        <td>${hm}</td>
        <td>${finals}</td>
        <td>${offers}</td>
        <td>${notes.join(" · ") || "—"}</td>
      `;
      tbody.appendChild(tr);
    }
  }

  function applyScenario(key) {
    const s = SCENARIOS[key] || SCENARIOS.base;
    $("offerAccept").value = s.offerAccept;
    $("finalToOffer").value = s.finalToOffer;
    $("hmToFinal").value = s.hmToFinal;
    $("riToHm").value = s.riToHm;
    $("appToRi").value = s.appToRi;

    const note = $("scenarioNote");
    if (note) note.textContent = s.note;

    onCalculate();
  }

  function setDefaultDates() {
    const today = new Date();
    today.setHours(0,0,0,0);

    const req = startOfWeek(today);
    const start = addDays(req, 7 * 10);

    $("reqOpenDate").value = req.toISOString().slice(0,10);
    $("newHireStartDate").value = start.toISOString().slice(0,10);
  }

  function onCalculate() {
    $("error").textContent = "";
    const inp = readInputs();
    const err = validate(inp);
    if (err) {
      $("error").textContent = err;
      return;
    }

    const funnel = calcFunnel(inp);
    const milestones = computeMilestones(inp);
    const plan = buildPlan(inp, milestones, funnel);

    renderOutputs(inp, milestones, funnel, plan);
    buildPlanner(inp, milestones, funnel, plan);
  }

  function onReset() {
    setDefaultDates();
    $("weeksSourcingBeforeInterviews").value = 3;
    $("weeksOfferToAccept").value = 2;
    $("weeksAcceptanceToStart").value = 2;
    $("hires").value = 4;

    $("error").textContent = "";
    $("constraintText").textContent = "Enter values and click Calculate.";

    applyScenario("base");
  }

  document.querySelectorAll("[data-scn]").forEach(btn => {
    btn.addEventListener("click", () => applyScenario(btn.dataset.scn));
  });

  $("calcBtn").addEventListener("click", onCalculate);
  $("resetBtn").addEventListener("click", onReset);

  [
    "reqOpenDate","newHireStartDate",
    "weeksSourcingBeforeInterviews","weeksOfferToAccept","weeksAcceptanceToStart",
    "hires","offerAccept","finalToOffer","hmToFinal","riToHm","appToRi"
  ].forEach(id => $(id).addEventListener("input", () => {
    window.clearTimeout(window.__t);
    window.__t = window.setTimeout(onCalculate, 180);
  }));

  setDefaultDates();
  applyScenario("base");
</script>