<script>
  const $ = (id) => document.getElementById(id);

  const SCENARIOS = {
    base:   { note: "Base: typical conversion rates",                           offerAccept: 85, finalToOffer: 25, hmToFinal: 75, riToHm: 50, appToRi: 10 },
    tight:  { note: "Capacity constrained: weaker pass-through",                offerAccept: 80, finalToOffer: 20, hmToFinal: 60, riToHm: 40, appToRi: 8  },
    improve:{ note: "Improve CVRs: better calibration + structured screening",  offerAccept: 88, finalToOffer: 30, hmToFinal: 80, riToHm: 55, appToRi: 12 }
  };

  function clamp01(x){ return Number.isFinite(x) ? Math.max(0, Math.min(1, x)) : NaN; }
  function ceilInt(x){ return Number.isFinite(x) ? Math.ceil(x) : NaN; }

  function parseDateInput(v){
    if (!v) return null;
    const d = new Date(v + "T00:00:00");
    return Number.isNaN(d.getTime()) ? null : d;
  }

  function addDays(d, days){
    const out = new Date(d.getTime());
    out.setDate(out.getDate() + days);
    return out;
  }

  function startOfWeek(d){
    const out = new Date(d.getTime());
    const day = out.getDay();
    // Sunday (0) snaps forward to next Monday; all other days snap back to their Monday
    const diffToMon = day === 0 ? 1 : 1 - day;
    out.setDate(out.getDate() + diffToMon);
    out.setHours(0,0,0,0);
    return out;
  }

  function weekKey(d){
  if (!d) return ""; // Week 0 placeholder
  const m = d.toLocaleDateString(undefined, { month:"short" });
  const day = String(d.getDate()).padStart(2,"0");
  return `${m} ${day}`;
  }

  function fmtDate(d){
    if (!d) return "—";
    return `${d.getMonth()+1}/${d.getDate()}/${d.getFullYear()}`;
  }

  function diffWeeks(a, b){
    const ms = startOfWeek(b).getTime() - startOfWeek(a).getTime();
    return Math.round(ms / (7 * 24 * 60 * 60 * 1000));
  }

  function fmt(x, decimals=1){
    if (!Number.isFinite(x)) return "—";
    return x.toLocaleString(undefined, { maximumFractionDigits: decimals });
  }

  function readInputs(){
    return {
      reqOpenDate:                    parseDateInput($("reqOpenDate").value),
      newHireStartDate:               parseDateInput($("newHireStartDate").value),
      weeksSourcingBeforeInterviews:  parseInt($("weeksSourcingBeforeInterviews").value, 10),
      weeksOfferToAccept:             parseInt($("weeksOfferToAccept").value, 10),
      weeksAcceptanceToStart:         parseInt($("weeksAcceptanceToStart").value, 10),
      hires:                          parseInt($("hires").value, 10),
      // CVR inputs are 0–100 on screen; divide by 100 for math
      offerAccept:   clamp01(parseFloat($("offerAccept").value)   / 100),
      finalToOffer:  clamp01(parseFloat($("finalToOffer").value)  / 100),
      hmToFinal:     clamp01(parseFloat($("hmToFinal").value)     / 100),
      riToHm:        clamp01(parseFloat($("riToHm").value)        / 100),
      appToRi:       clamp01(parseFloat($("appToRi").value)       / 100)
    };
  }

  function validate(inp){
    if (!inp.reqOpenDate)      return "Requisition open date is required.";
    if (!inp.newHireStartDate) return "New hire start date is required.";
    if (inp.newHireStartDate.getTime() <= inp.reqOpenDate.getTime())
      return "New hire start date must be after req open date.";

    // Check the back-calculated offer window leaves room for at least 1 interview week
    const riStart_v  = addDays(inp.reqOpenDate, 7 * inp.weeksSourcingBeforeInterviews);
    const offerEnd_v = addDays(inp.newHireStartDate,
      -7 * inp.weeksAcceptanceToStart - 7 * Math.max(1, inp.weeksOfferToAccept));
    if (offerEnd_v.getTime() <= riStart_v.getTime())
      return "Not enough time for interviews — move the start date out or reduce admin weeks.";

    const ints = [
      ["Weeks sourcing before interviews", inp.weeksSourcingBeforeInterviews],
      ["Weeks offer → acceptance",         inp.weeksOfferToAccept],
      ["Weeks acceptance → start",         inp.weeksAcceptanceToStart],
    ];
    for (const [name, v] of ints){
      if (!Number.isFinite(v) || v < 0) return `${name} must be 0 or more.`;
    }

    if (!Number.isFinite(inp.hires) || inp.hires <= 0) return "Target hires must be ≥ 1.";

    const rates = [
      ["Offer accept rate",   inp.offerAccept],
      ["Final → Offer",       inp.finalToOffer],
      ["HMI → Final",         inp.hmToFinal],
      ["RI → HMI",            inp.riToHm],
      ["App → RI",            inp.appToRi]
    ];
    for (const [name, v] of rates){
      if (!Number.isFinite(v) || v <= 0) return `${name} must be > 0.`;
      if (v > 1)                         return `${name} must be ≤ 100%.`;
    }
    return null;
  }

  function calcTotals(inp){
    const offersNeeded = inp.hires / inp.offerAccept;
    const finalsNeeded = offersNeeded / inp.finalToOffer;
    const hmNeeded     = finalsNeeded / inp.hmToFinal;
    const riNeeded     = hmNeeded     / inp.riToHm;
    const appsNeeded   = riNeeded     / inp.appToRi;
    return {
      hires:  inp.hires,
      offers: ceilInt(offersNeeded),
      finals: ceilInt(finalsNeeded),
      hm:     ceilInt(hmNeeded),
      ri:     ceilInt(riNeeded),
      apps:   ceilInt(appsNeeded)
    };
  }

  function computeMilestones(inp){
    const reqW     = startOfWeek(inp.reqOpenDate);
    const riStartW = addDays(reqW, 7 * inp.weeksSourcingBeforeInterviews);

    // Back-calculate from new hire start date so interview window reflects reality
    const hireStartW  = startOfWeek(inp.newHireStartDate);
    const acceptW     = addDays(hireStartW,  -7 * inp.weeksAcceptanceToStart);
    const offerStartW = addDays(acceptW,     -7 * Math.max(1, inp.weeksOfferToAccept));
    const finalStartW = addDays(offerStartW, -7);
    const hmStartW    = addDays(riStartW, 7);

    const hireByW              = acceptW;
    const ttfWeeks             = Math.max(1, diffWeeks(reqW, hireByW));
    const activeInterviewWeeks = Math.max(1, diffWeeks(riStartW, offerStartW));

    return { reqW, riStartW, hmStartW, finalStartW, offerStartW, acceptW, hireByW, ttfWeeks, activeInterviewWeeks };
  }

  function distribute(total, lenWeeks){
    const out = Array.from({ length: lenWeeks }, () => 0);
    if (lenWeeks <= 0 || !Number.isFinite(total) || total <= 0) return out;
    const rate = total / lenWeeks;
    let acc = 0;
    for (let i = 0; i < lenWeeks; i++){
      const prev = Math.floor(acc); acc += rate;
      out[i] = Math.max(0, Math.floor(acc) - prev);
    }
    let sum = out.reduce((a,b)=>a+b,0);
    while (sum < total){ out[out.length-1] += 1; sum += 1; }
    while (sum > total){
      for (let i = out.length-1; i >= 0 && sum > total; i--){
        if (out[i] > 0){ out[i] -= 1; sum -= 1; }
      }
      if (sum > total) break;
    }
    return out;
  }
  function scheduleOffersFromFinals(finalArr, offersTotal, finalsPerOffer = 4){
  const out = Array.from({ length: finalArr.length }, () => 0);
  if (!Number.isFinite(offersTotal) || offersTotal <= 0) return out;

  let finalsCum = 0;
  let offersPlaced = 0;

  for (let i = 0; i < finalArr.length && offersPlaced < offersTotal; i++){
    finalsCum += (finalArr[i] || 0);
    const shouldHave = Math.floor(finalsCum / finalsPerOffer);
    let add = shouldHave - offersPlaced;
    if (add > 0){
      if (offersPlaced + add > offersTotal) add = offersTotal - offersPlaced;
      out[i] = add;
      offersPlaced += add;
    }
  }

  // If we never hit enough finals thresholds, dump remainder into last week that has finals
  if (offersPlaced < offersTotal){
    for (let i = out.length - 1; i >= 0; i--){
      if ((finalArr[i] || 0) > 0){
        out[i] += (offersTotal - offersPlaced);
        offersPlaced = offersTotal;
        break;
      }
    }
  }

  // Still nothing (edge-case): dump remainder at very end
  if (offersPlaced < offersTotal){
    out[out.length - 1] += (offersTotal - offersPlaced);
  }

  return out;
}

  function buildPlanner(inp, ms, totals){
  // Sheet behavior:
  // - Week 0 = placeholder (no date)
  // - Week 1 date = Req Open week start
  // - Table ends on the week BEFORE hire-by (accepts) week
  //   (hire-by can be the Monday after the last work week)


  const reqWeekStart    = startOfWeek(inp.reqOpenDate);
  const hireByWeekStart = startOfWeek(ms.hireByW);

  const bucketWeeks = diffWeeks(reqWeekStart, hireByWeekStart) + 1;

  const rows = bucketWeeks + 1;

  const weeks = Array.from({ length: rows }, (_, i) => {
    if (i === 0) return null; // week 0 placeholder
    return addDays(reqWeekStart, (i - 1) * 7);
  });

  // Determine interview production window (weeks where RI runs)
  // Active interview weeks should be between RI start and offer-start boundary in your model.
  // Here we treat "active interview weeks" as the RI production weeks count.
  const riWeeks = Math.max(1, ms.activeInterviewWeeks);

  // Indices in the planner table
  const idxReq = 1; // week 1 = req open week
  const idxRi = idxReq + inp.weeksSourcingBeforeInterviews; // if 0, RI can start week 1
  const idxHm = idxRi + 1;
  const idxFinal = idxRi + 2;

  // Stage durations (feed-next-week style like your sheet)
  const hmWeeks = Math.max(0, riWeeks - 1);
  const finalWeeks = Math.max(0, riWeeks - 2);

  // Apps can run starting at req open week (week 1), and can extend into sourcing lead time
  // If sourcing lead time is 0, this still works (appsWeeks = riWeeks - 1, can be 0).
  const appsWeeks = Math.max(0, riWeeks - 1 + inp.weeksSourcingBeforeInterviews);

  // Allocate stage volumes across their production windows (integer distribution)
  const appsArr  = Array.from({ length: rows }, () => 0);
  const riArr    = Array.from({ length: rows }, () => 0);
  const hmArr    = Array.from({ length: rows }, () => 0);
  const finalArr = Array.from({ length: rows }, () => 0);
  const offerArr = Array.from({ length: rows }, () => 0);
  const hireArr  = Array.from({ length: rows }, () => 0);

  const place = (dist, startIdx, arr) => {
    dist.forEach((v, i) => {
      const idx = startIdx + i;
      if (idx >= 0 && idx < rows) arr[idx] = v;
    });
  };

  place(distribute(totals.apps,   appsWeeks),  idxReq,   appsArr);
  place(distribute(totals.ri,     riWeeks),    idxRi,    riArr);
  place(distribute(totals.hm,     hmWeeks),    idxHm,    hmArr);
  place(distribute(totals.finals, finalWeeks), idxFinal, finalArr);

  // === Offers from Finals (sheet-style progressive issuance) ===
  // Offers accumulate as finals accumulate:
  // offersByNow = floor(cumFinals * finalToOffer)
  // offersThisWeek = offersByNow - offersSoFar
  let cumFinals = 0;
  let offersSoFar = 0;
  for (let i = 0; i < rows; i++){
    cumFinals += finalArr[i];
    const targetOffersByNow = Math.floor(cumFinals * inp.finalToOffer + 1e-9);
    let add = targetOffersByNow - offersSoFar;
    if (add < 0) add = 0;

    // cap to total offers needed
    if (offersSoFar + add > totals.offers) add = totals.offers - offersSoFar;

    offerArr[i] = add;
    offersSoFar += add;
  }

  // === Hires from Offers (accepts) ===
  // hiresByNow = floor(cumOffers * offerAccept)
  let cumOffers = 0;
  let hiresSoFar = 0;
  for (let i = 0; i < rows; i++){
    cumOffers += offerArr[i];
    const targetHiresByNow = Math.floor(cumOffers * inp.offerAccept + 1e-9);
    let add = targetHiresByNow - hiresSoFar;
    if (add < 0) add = 0;

    if (hiresSoFar + add > totals.hires) add = totals.hires - hiresSoFar;

    hireArr[i] = add;
    hiresSoFar += add;
  }

  // Offer start week = first row where offers appear (date belongs to that row)
  let offerStartW = null;
  for (let i = 0; i < rows; i++){
    if (offerArr[i] > 0){
      offerStartW = weeks[i]; // can be null if somehow in week 0, but that won't happen here
      break;
    }
  }

  // Per-week pace numbers (for your header text)
  const rates = {
    appsPerWk:   appsWeeks   > 0 ? totals.apps   / appsWeeks   : NaN,
    riPerWk:     riWeeks     > 0 ? totals.ri     / riWeeks     : NaN,
    hmPerWk:     hmWeeks     > 0 ? totals.hm     / hmWeeks     : NaN,
    finalPerWk:  finalWeeks  > 0 ? totals.finals / finalWeeks  : NaN,
    offersPerWk: riWeeks     > 0 ? totals.offers / riWeeks     : NaN, // pace across active window (sheet-like)
    hiresPerWk:  riWeeks     > 0 ? totals.hires  / riWeeks     : NaN
  };

  return {
    weeks,
    series: { appsArr, riArr, hmArr, finalArr, offerArr, hireArr },
    rates,
    offerStartW
  };
}

  function render(inp, ms, totals, plan){
    // Funnel stage volumes
    $("totApps").textContent   = totals.apps.toLocaleString();
    $("totRi").textContent     = totals.ri.toLocaleString();
    $("totHm").textContent     = totals.hm.toLocaleString();
    $("totFinal").textContent  = totals.finals.toLocaleString();
    $("totOffers").textContent = totals.offers.toLocaleString();
    $("totHires").textContent  = totals.hires.toLocaleString();

    // Funnel bar widths (normalised to apps = 100%)
    const maxVol = totals.apps || 1;
    const pct = (v) => (Math.max(2, Math.round(v / maxVol * 100))) + "%";
    $("barApps").style.width   = "100%";
    $("barRi").style.width     = pct(totals.ri);
    $("barHm").style.width     = pct(totals.hm);
    $("barFinal").style.width  = pct(totals.finals);
    $("barOffers").style.width = pct(totals.offers);
    $("barHires").style.width  = pct(totals.hires);

    // Outputs
    $("outActiveInterviewWeeks").textContent = ms.activeInterviewWeeks.toLocaleString();
    $("outTimeToFill").textContent           = ms.ttfWeeks.toLocaleString();
    $("outRatio").textContent                = fmt(totals.apps / inp.hires, 1);
    const firstOfferIdx = plan.series.offerArr.findIndex(v => (v || 0) > 0);
    const firstOfferDate = firstOfferIdx > 0 ? plan.weeks[firstOfferIdx] : null; // idx 0 is placeholder
    $("outOfferStart").textContent = fmtDate(plan.offerStartW);
    $("outHireBy").textContent               = fmtDate(addDays(inp.newHireStartDate, -7 * inp.weeksAcceptanceToStart));
    $("outHireStart").textContent            = fmtDate(inp.newHireStartDate);

    // Planner per-week header
    $("wkApps").textContent   = fmt(plan.rates.appsPerWk,   1);
    $("wkRi").textContent     = fmt(plan.rates.riPerWk,     1);
    $("wkHm").textContent     = fmt(plan.rates.hmPerWk,     1);
    $("wkFinal").textContent  = fmt(plan.rates.finalPerWk,  1);
    $("wkOffers").textContent = fmt(plan.rates.offersPerWk, 1);

    // Constraint callout
    const top = [
      ["Applications", plan.rates.appsPerWk],
      ["RI",           plan.rates.riPerWk],
      ["HMI",          plan.rates.hmPerWk],
      ["Final",        plan.rates.finalPerWk],
      ["Offers",       plan.rates.offersPerWk],
    ].filter(x => Number.isFinite(x[1])).sort((a,b) => b[1] - a[1])[0];
    $("constraintNote").textContent = top
      ? `Constraint signal: ~${fmt(top[1],1)} ${top[0]} needed per active week.`
      : "";

    // Planner table
    const tbody = $("plannerBody");
    tbody.innerHTML = "";

    // Totals row
    const tr0 = document.createElement("tr");
    tr0.className = "totals-row";
    tr0.innerHTML = `
      <td>${ms.ttfWeeks} wks</td>
      <td>${weekKey(ms.reqW)}</td>
      <td>${totals.apps.toLocaleString()}</td>
      <td>${totals.ri.toLocaleString()}</td>
      <td>${totals.hm.toLocaleString()}</td>
      <td>${totals.finals.toLocaleString()}</td>
      <td>${totals.offers.toLocaleString()}</td>
      <td>${totals.hires.toLocaleString()}</td>
    `;
    tbody.appendChild(tr0);

    // Weekly rows
    plan.weeks.forEach((wkStart, i) => {
      const tr = document.createElement("tr");
      tr.className = "week-row";
      const s = plan.series;
      const cell = (v) => v ? v.toLocaleString() : "";
    tr.innerHTML = `
     <td>${i}</td>
     <td>${weekKey(wkStart)}</td>
     <td>${cell(s.appsArr[i])}</td>
     <td>${cell(s.riArr[i])}</td>
     <td>${cell(s.hmArr[i])}</td>
     <td>${cell(s.finalArr[i])}</td>
     <td>${cell(s.offerArr[i])}</td>
     <td>${cell(s.hireArr[i])}</td>
    `;
      tbody.appendChild(tr);
    });
  }

  function applyScenario(key){
    const s = SCENARIOS[key] || SCENARIOS.base;
    $("offerAccept").value  = s.offerAccept;
    $("finalToOffer").value = s.finalToOffer;
    $("hmToFinal").value    = s.hmToFinal;
    $("riToHm").value       = s.riToHm;
    $("appToRi").value      = s.appToRi;
    $("scenarioNote").textContent = s.note;
    onCalculate();
  }

  function setDefaultDates(){
    const today = new Date(); today.setHours(0,0,0,0);
    const req = today;
    const start = addDays(req, 7 * 20);
    $("reqOpenDate").value      = req.toISOString().slice(0,10);
    $("newHireStartDate").value = start.toISOString().slice(0,10);
  }

  function onCalculate(){
    $("error").textContent = "";
    const inp = readInputs();
    const err = validate(inp);
    if (err){ $("error").textContent = err; return; }
    const totals = calcTotals(inp);
    const ms     = computeMilestones(inp);
    const plan   = buildPlanner(inp, ms, totals);
    render(inp, ms, totals, plan);
  }

  document.querySelectorAll("[data-scn]").forEach(btn =>
    btn.addEventListener("click", () => applyScenario(btn.dataset.scn))
  );

  [
    "reqOpenDate","newHireStartDate",
    "weeksSourcingBeforeInterviews","weeksOfferToAccept","weeksAcceptanceToStart",
    "hires","offerAccept","finalToOffer","hmToFinal","riToHm","appToRi"
  ].forEach(id => $(id).addEventListener("input", () => {
    window.clearTimeout(window.__t);
    window.__t = window.setTimeout(onCalculate, 180);
  }));

  setDefaultDates();
  applyScenario("base");
</script>
