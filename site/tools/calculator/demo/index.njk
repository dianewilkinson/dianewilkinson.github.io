<script>
  const $ = (id) => document.getElementById(id);

  const SCENARIOS = {
    base:   { note: "Base: typical conversion rates", offerAccept: 0.85, finalToOffer: 0.25, hmToFinal: 0.75, riToHm: 0.50, appToRi: 0.10 },
    tight:  { note: "Capacity constrained: weaker pass-through", offerAccept: 0.80, finalToOffer: 0.20, hmToFinal: 0.60, riToHm: 0.40, appToRi: 0.08 },
    improve:{ note: "Improve CVRs: better calibration + structured screening", offerAccept: 0.88, finalToOffer: 0.30, hmToFinal: 0.80, riToHm: 0.55, appToRi: 0.12 }
  };

  function clamp01(x) {
    if (!Number.isFinite(x)) return NaN;
    return Math.max(0, Math.min(1, x));
  }
  function safeCeil(x) {
    if (!Number.isFinite(x)) return NaN;
    return Math.ceil(x);
  }
  function parseDateInput(v) {
    if (!v) return null;
    const d = new Date(v + "T00:00:00");
    return Number.isNaN(d.getTime()) ? null : d;
  }
  function addDays(d, days) {
    const out = new Date(d.getTime());
    out.setDate(out.getDate() + days);
    return out;
  }
  function startOfWeek(d) {
    const out = new Date(d.getTime());
    const day = out.getDay(); // 0=Sun
    const diffToMon = (day === 0 ? -6 : 1) - day;
    out.setDate(out.getDate() + diffToMon);
    out.setHours(0,0,0,0);
    return out;
  }
  function weekKey(d) {
    // "Feb-27" (no weekday; avoids wrapping)
    const m = d.toLocaleDateString(undefined, { month: "short" });
    const day = d.toLocaleDateString(undefined, { day: "2-digit" });
    return `${m}-${day}`;
  }
  function diffWeeks(a, b) {
    const ms = startOfWeek(b).getTime() - startOfWeek(a).getTime();
    return Math.round(ms / (7 * 24 * 60 * 60 * 1000));
  }
  function fmt(x, decimals = 1) {
    if (!Number.isFinite(x)) return "—";
    return x.toLocaleString(undefined, { maximumFractionDigits: decimals });
  }

  function readInputs() {
    const reqOpenDate = parseDateInput($("reqOpenDate").value);
    const newHireStartDate = parseDateInput($("newHireStartDate").value);

    const weeksSourcingBeforeInterviews = parseInt($("weeksSourcingBeforeInterviews").value, 10);
    const weeksOfferToAccept = parseInt($("weeksOfferToAccept").value, 10);
    const weeksAcceptanceToStart = parseInt($("weeksAcceptanceToStart").value, 10);

    const hires = parseInt($("hires").value, 10);

    const offerAccept = clamp01(parseFloat($("offerAccept").value));
    const finalToOffer = clamp01(parseFloat($("finalToOffer").value));
    const hmToFinal = clamp01(parseFloat($("hmToFinal").value));
    const riToHm = clamp01(parseFloat($("riToHm").value));
    const appToRi = clamp01(parseFloat($("appToRi").value));

    return {
      reqOpenDate,
      newHireStartDate,
      weeksSourcingBeforeInterviews,
      weeksOfferToAccept,
      weeksAcceptanceToStart,
      hires,
      offerAccept,
      finalToOffer,
      hmToFinal,
      riToHm,
      appToRi
    };
  }

  function validate(inp) {
    if (!inp.reqOpenDate) return "Requisition Open Date is required.";
    if (!inp.newHireStartDate) return "New Hire Start Date is required.";
    if (inp.newHireStartDate.getTime() <= inp.reqOpenDate.getTime()) return "New Hire Start Date must be after Req Open Date.";

    const ints = [
      ["# Weeks Sourcing Before Interviews", inp.weeksSourcingBeforeInterviews],
      ["# Weeks Offer to Accept", inp.weeksOfferToAccept],
      ["# Weeks Acceptance to Start", inp.weeksAcceptanceToStart]
    ];
    for (const [name, v] of ints) {
      if (!Number.isFinite(v) || v < 0) return `${name} must be 0 or more.`;
    }

    if (!Number.isFinite(inp.hires) || inp.hires <= 0) return "Target hires must be >= 1.";

    const rates = [
      ["Offer accept rate", inp.offerAccept],
      ["Final → Offer", inp.finalToOffer],
      ["HM → Final", inp.hmToFinal],
      ["Recruiter Interview → HM", inp.riToHm],
      ["App → Recruiter Interview", inp.appToRi]
    ];
    for (const [name, v] of rates) {
      if (!Number.isFinite(v)) return `${name} must be a number between 0 and 1.`;
      if (v <= 0) return `${name} must be > 0 (or the funnel becomes infinite).`;
      if (v > 1) return `${name} must be <= 1.`;
    }

    return null;
  }

  function calcFunnel(inp) {
    const hires = inp.hires;

    const offersNeeded = hires / inp.offerAccept;
    const finalsNeeded = offersNeeded / inp.finalToOffer;
    const hmNeeded = finalsNeeded / inp.hmToFinal;
    const riNeeded = hmNeeded / inp.riToHm;
    const appsNeeded = riNeeded / inp.appToRi;

    return {
      offers: safeCeil(offersNeeded),
      finals: safeCeil(finalsNeeded),
      hm: safeCeil(hmNeeded),
      ri: safeCeil(riNeeded),
      apps: safeCeil(appsNeeded),
      hires
    };
  }

  // Sheet-style, dependency-driven milestones
  function computeMilestones(inp) {
    const reqW = startOfWeek(inp.reqOpenDate);

    // Apps begin immediately (req open week)
    const appsStartW = reqW;

    // RI starts after sourcing lead time (0 allowed)
    const riStartW = addDays(reqW, 7 * inp.weeksSourcingBeforeInterviews);
    const hmStartW = addDays(riStartW, 7 * 1);
    const finalStartW = addDays(hmStartW, 7 * 1);

    // Offers start the week after Finals start (sheet-style cascade)
    const offerStartW = addDays(finalStartW, 7 * 1);

    // Acceptance week is offerStart + offerToAccept weeks (hire-by = accepts)
    const acceptW = addDays(offerStartW, 7 * inp.weeksOfferToAccept);

    // Start week is acceptance week + acceptanceToStart weeks
    const startW = addDays(acceptW, 7 * inp.weeksAcceptanceToStart);

    return { reqW, appsStartW, riStartW, hmStartW, finalStartW, offerStartW, acceptW, startW };
  }

  function computeStageWeeks(inp, milestones) {
    // RI weeks are from RI start up to (but not including) Offer start
    const riWeeks = Math.max(1, diffWeeks(milestones.riStartW, milestones.offerStartW));

    // Cascade one-week offsets (feed-next-week)
    const hmWeeks = Math.max(0, riWeeks - 1);
    const finalWeeks = Math.max(0, riWeeks - 2);

    // Apps stop one week before final RI week.
    // User rule:
    // - If sourcing=0 and RI runs 4 weeks, apps run 3 weeks
    // - If sourcing=1, apps run 4 weeks
    // - If sourcing=2, apps run 5 weeks, etc.
    // => appsWeeks = (riWeeks - 1) + weeksSourcingBeforeInterviews
    const appsWeeks = Math.max(0, (riWeeks - 1) + inp.weeksSourcingBeforeInterviews);

    // Offers are user-driven offer->accept weeks; if 0, keep offers in the offerStart week
    const offerWeeks = Math.max(1, inp.weeksOfferToAccept);

    return { appsWeeks, riWeeks, hmWeeks, finalWeeks, offerWeeks };
  }

  function buildPlan(inp, milestones, funnel) {
    const w = computeStageWeeks(inp, milestones);

    // Weekly rates mirror your sheet “Needed per week = …”
    const appsPerWk   = w.appsWeeks  > 0 ? (funnel.apps   / w.appsWeeks)  : NaN;
    const riPerWk     = w.riWeeks    > 0 ? (funnel.ri     / w.riWeeks)    : NaN;
    const hmPerWk     = w.hmWeeks    > 0 ? (funnel.hm     / w.hmWeeks)    : NaN;
    const finalsPerWk = w.finalWeeks > 0 ? (funnel.finals / w.finalWeeks) : NaN;
    const offersPerWk = w.offerWeeks > 0 ? (funnel.offers / w.offerWeeks) : NaN;

    return {
      stageWeeks: w,
      rates: { appsPerWk, riPerWk, hmPerWk, finalsPerWk, offersPerWk },
      activeInterviewWeeks: w.riWeeks
    };
  }

  function phaseForWeek(wkStart, milestones) {
    const t = wkStart.getTime();
    const ri = milestones.riStartW.getTime();
    const offer = milestones.offerStartW.getTime();
    const accept = milestones.acceptW.getTime();
    const start = milestones.startW.getTime();

    if (t < ri) return "Sourcing";
    if (t >= ri && t < offer) return "Interviews";
    if (t >= offer && t < accept) return "Offer";
    if (t >= accept && t < start) return "Pre-start";
    if (t >= start) return "Start";
    return "—";
  }

  function inWindow(wkStart, stageStart, lenWeeks) {
    const d = diffWeeks(stageStart, wkStart);
    return d >= 0 && d < lenWeeks;
  }

  function renderFunnelTotals(funnel) {
    $("fApps").textContent = funnel.apps.toLocaleString();
    $("fRi").textContent = funnel.ri.toLocaleString();
    $("fHm").textContent = funnel.hm.toLocaleString();
    $("fFinals").textContent = funnel.finals.toLocaleString();
    $("fOffers").textContent = funnel.offers.toLocaleString();
    $("fHires").textContent = funnel.hires.toLocaleString();
  }

  function renderOutputs(inp, milestones, funnel, plan) {
    const ttf = diffWeeks(milestones.reqW, milestones.startW);

    // top Outputs boxes
    $("outActiveInterviewWeeks").textContent = plan.activeInterviewWeeks.toLocaleString();
    $("outHireByDate").textContent = weekKey(milestones.acceptW);        // Hire-by = accepts (week)
    $("outOfferStartDate").textContent = weekKey(milestones.offerStartW);
    $("outStartDate").textContent = weekKey(milestones.startW);
    $("outRatio").textContent = fmt(funnel.apps / Math.max(1, inp.hires), 1);

    // milestone line
    $("outReqOpenWeek").textContent = weekKey(milestones.reqW);
    $("outRiStartWeek").textContent = weekKey(milestones.riStartW);
    $("outAcceptWeek").textContent = weekKey(milestones.acceptW);
    $("outTimeToFill").textContent = ttf.toLocaleString();

    // planner aligned boxes
    $("bxTTF").textContent = ttf.toLocaleString();
    $("bxWeekStart").textContent = weekKey(milestones.reqW);
    $("bxApps").textContent = funnel.apps.toLocaleString();
    $("bxRi").textContent = funnel.ri.toLocaleString();
    $("bxHm").textContent = funnel.hm.toLocaleString();
    $("bxFinals").textContent = funnel.finals.toLocaleString();
    $("bxOffers").textContent = funnel.offers.toLocaleString();
    $("bxHires").textContent = funnel.hires.toLocaleString();

    // needed / wk row
    $("outAppsPerWk").textContent = fmt(plan.rates.appsPerWk, 1);
    $("outRiPerWk").textContent = fmt(plan.rates.riPerWk, 1);
    $("outHmPerWk").textContent = fmt(plan.rates.hmPerWk, 1);
    $("outFinalPerWk").textContent = fmt(plan.rates.finalsPerWk, 1);
    $("outOffersPerWk").textContent = fmt(plan.rates.offersPerWk, 1);

    // constraint signal
    const weekly = [
      ["applications", plan.rates.appsPerWk],
      ["recruiter screens", plan.rates.riPerWk],
      ["hm interviews", plan.rates.hmPerWk],
      ["final interviews", plan.rates.finalsPerWk],
      ["offers", plan.rates.offersPerWk]
    ].filter(x => Number.isFinite(x[1]))
     .sort((a,b) => b[1] - a[1]);

    if (weekly.length) {
      const [label, val] = weekly[0];
      $("constraintText").textContent = `Constraint signal: ~${fmt(val,1)} ${label} per week in the planned window.`;
    } else {
      $("constraintText").textContent = "—";
    }

    // funnel viz (stacked pills)
    const viz = $("funnelViz");
    viz.innerHTML = "";
    const stages = [
      { label: "Applications", val: funnel.apps },
      { label: "Recruiter Interviews", val: funnel.ri },
      { label: "HM Interviews", val: funnel.hm },
      { label: "Finals", val: funnel.finals },
      { label: "Offers", val: funnel.offers },
      { label: "Hires", val: funnel.hires }
    ];
    const widths = [100, 92, 84, 76, 68, 60];

    stages.forEach((s, i) => {
      const row = document.createElement("div");
      row.style.display = "flex";
      row.style.alignItems = "center";
      row.style.gap = "10px";

      const pill = document.createElement("div");
      pill.style.width = widths[i] + "%";
      pill.style.margin = "0 auto";
      pill.style.padding = "8px 10px";
      pill.style.borderRadius = "999px";
      pill.style.border = "1px solid var(--border)";
      pill.style.background = "var(--card)";
      pill.style.display = "flex";
      pill.style.justifyContent = "space-between";
      pill.style.fontWeight = "700";
      pill.innerHTML = `<span>${s.label}</span><span>${s.val.toLocaleString()}</span>`;

      row.appendChild(pill);
      viz.appendChild(row);
    });
  }

  function buildPlanner(inp, milestones, plan) {
    const tbody = $("plannerBody");
    tbody.innerHTML = "";

    // Show weeks from req open to start week (inclusive)
    const start = milestones.reqW;
    const end = milestones.startW;
    const totalWeeks = Math.max(1, diffWeeks(start, addDays(end, 7)));
    const weekStarts = Array.from({ length: totalWeeks }, (_, i) => addDays(start, i * 7));

    const w = plan.stageWeeks;

    for (let i = 0; i < weekStarts.length; i++) {
      const wkStart = weekStarts[i];
      const phase = phaseForWeek(wkStart, milestones);

      // Windows (feed-next-week cascade)
      const apps  = inWindow(wkStart, milestones.appsStartW,  w.appsWeeks)   ? fmt(plan.rates.appsPerWk, 1)   : "";
      const ri    = inWindow(wkStart, milestones.riStartW,    w.riWeeks)     ? fmt(plan.rates.riPerWk, 1)     : "";
      const hm    = inWindow(wkStart, milestones.hmStartW,    w.hmWeeks)     ? fmt(plan.rates.hmPerWk, 1)     : "";
      const fin   = inWindow(wkStart, milestones.finalStartW, w.finalWeeks)  ? fmt(plan.rates.finalsPerWk, 1) : "";
      const off   = inWindow(wkStart, milestones.offerStartW, w.offerWeeks)  ? fmt(plan.rates.offersPerWk, 1) : "";

      const tr = document.createElement("tr");
      tr.innerHTML = `
        <td>${i + 1}</td>
        <td>${weekKey(wkStart)}</td>
        <td>${phase}</td>
        <td>${apps}</td>
        <td>${ri}</td>
        <td>${hm}</td>
        <td>${fin}</td>
        <td>${off}</td>
      `;
      tbody.appendChild(tr);
    }

    $("plannerNote").textContent =
      `Rule: Apps feed next-week RI, so apps stop one week before the final RI week. Offers begin the week after Finals and run for the Offer→Accept input weeks.`;
  }

  function applyScenario(key) {
    const s = SCENARIOS[key] || SCENARIOS.base;
    $("offerAccept").value = s.offerAccept;
    $("finalToOffer").value = s.finalToOffer;
    $("hmToFinal").value = s.hmToFinal;
    $("riToHm").value = s.riToHm;
    $("appToRi").value = s.appToRi;

    const note = $("scenarioNote");
    if (note) note.textContent = s.note;

    onCalculate();
  }

  function setDefaultDates() {
    const today = new Date();
    today.setHours(0,0,0,0);

    const req = startOfWeek(today);
    const start = addDays(req, 7 * 20);

    $("reqOpenDate").value = req.toISOString().slice(0,10);
    $("newHireStartDate").value = start.toISOString().slice(0,10);
  }

  function onCalculate() {
    $("error").textContent = "";
    const inp = readInputs();
    const err = validate(inp);
    if (err) {
      $("error").textContent = err;
      return;
    }

    const funnel = calcFunnel(inp);
    const milestones = computeMilestones(inp);
    const plan = buildPlan(inp, milestones, funnel);

    renderFunnelTotals(funnel);
    renderOutputs(inp, milestones, funnel, plan);
    buildPlanner(inp, milestones, plan);
  }

  function onReset() {
    setDefaultDates();
    $("weeksSourcingBeforeInterviews").value = 1;
    $("weeksOfferToAccept").value = 1;
    $("weeksAcceptanceToStart").value = 3;
    $("hires").value = 4;

    $("error").textContent = "";
    $("constraintText").textContent = "Enter values and click Calculate.";
    $("plannerNote").textContent = "";

    applyScenario("base");
  }

  document.querySelectorAll("[data-scn]").forEach(btn => {
    btn.addEventListener("click", () => applyScenario(btn.dataset.scn));
  });

  $("calcBtn").addEventListener("click", onCalculate);
  $("resetBtn").addEventListener("click", onReset);

  [
    "reqOpenDate","newHireStartDate",
    "weeksSourcingBeforeInterviews","weeksOfferToAccept","weeksAcceptanceToStart",
    "hires","offerAccept","finalToOffer","hmToFinal","riToHm","appToRi"
  ].forEach(id => $(id).addEventListener("input", () => {
    window.clearTimeout(window.__t);
    window.__t = window.setTimeout(onCalculate, 180);
  }));

  setDefaultDates();
  applyScenario("base");
</script>