      <button class="btnGhost" type="button" data-scn="tight">Capacity constrained</button>
      <button class="btnGhost" type="button" data-scn="improve">Improve CVRs</button>
      <span class="muted" id="scenarioNote"></span>
    </div>
  </div>
</section>

<section class="grid2">
  <!-- INPUTS -->
  <div class="card">
    <h2 class="section-title">Inputs</h2>
    <p class="section-sub">Start dates + admin timing assumptions.</p>

    <label>
      Requisition Open Date
      <input id="reqOpenDate" type="date" />
    </label>

    <div class="rule"></div>

    <label>
      New Hire Start Date
      <input id="newHireStartDate" type="date" />
    </label>

    <div class="rule"></div>

    <label>
      # Weeks Sourcing Before Interviews
      <input id="weeksSourcingBeforeInterviews" type="number" min="0" step="1" value="1" />
    </label>

    <div class="rule"></div>

    <label>
      # Weeks Offer to Accept
      <input id="weeksOfferToAccept" type="number" min="0" step="1" value="1" />
    </label>

    <div class="rule"></div>

    <label>
      # Weeks Acceptance to Start
      <input id="weeksAcceptanceToStart" type="number" min="0" step="1" value="3" />
    </label>

    <div class="rule"></div>

    <label>
      Target hires
      <input id="hires" type="number" min="1" step="1" value="4" />
    </label>

    <div class="rule"></div>

    <div class="ctaRow ctaRow--left">
      <button class="btn primary" id="calcBtn" type="button">Calculate</button>
      <button class="btnGhost" id="resetBtn" type="button">Reset</button>
      <span id="error" class="muted"></span>
    </div>
  </div>

  <!-- FUNNEL INPUTS -->
  <div class="card">
    <h2 class="section-title">Funnel</h2>
    <p class="section-sub">Stage conversions (0–1). Back-solves from hires.</p>

    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th align="left">Stage</th>
            <th align="left">Conversion</th>
            <th align="left">Rate (0–1)</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Applications</td>
            <td>App → Recruiter Interview</td>
            <td><input id="appToRi" type="number" min="0" max="1" step="0.01" value="0.10" /></td>
          </tr>
          <tr>
            <td>Recruiter Interview</td>
            <td>Recruiter Interview → HM</td>
            <td><input id="riToHm" type="number" min="0" max="1" step="0.01" value="0.50" /></td>
          </tr>
          <tr>
            <td>HM Interview</td>
            <td>HM → Final</td>
            <td><input id="hmToFinal" type="number" min="0" max="1" step="0.01" value="0.75" /></td>
          </tr>
          <tr>
            <td>Final</td>
            <td>Final → Offer</td>
            <td><input id="finalToOffer" type="number" min="0" max="1" step="0.01" value="0.25" /></td>
          </tr>
          <tr>
            <td>Offer</td>
            <td>Offer Accept Rate</td>
            <td><input id="offerAccept" type="number" min="0" max="1" step="0.01" value="0.85" /></td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="callout">
      Weekly timing is staggered by dependency: Apps (sourcing) → RI → HM → Final → Offer.
      Offers run for the Offer → Accept weeks (user input) and begin the week after Finals.
    </div>

    <p class="muted" id="constraintText">Enter values and click Calculate.</p>
  </div>
</section>

<!-- PLANNER -->
<section class="full">
  <h2 class="section-title">Weekly Time-To-Fill Planner</h2>
  <p class="section-sub">Sheet-style planner: totals row + weekly targets with staged start/stop points.</p>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th align="left">Time-to-Fill (Wks)<br>Week #</th>
          <th align="left">Rec Open Date<br>Week Start Dates</th>
          <th align="left"># Applications Needed</th>
          <th align="left">Recruiter Screens Needed</th>
          <th align="left"># Hiring Manager Interviews</th>
          <th align="left"># Final Interviews</th>
          <th align="left"># Offers Needed</th>
          <th align="left"># Hires Needed</th>
        </tr>

        <tr>
          <th align="left" class="muted">TTF (wks): <b id="outTimeToFill">—</b></th>
          <th align="left" class="muted">Req Open: <b id="outReqOpenWeek">—</b></th>

          <th align="left" class="muted">Needed / wk = <b id="outAppsPerWk">—</b></th>
          <th align="left" class="muted">Needed / wk = <b id="outRiPerWk">—</b></th>
          <th align="left" class="muted">Needed / wk = <b id="outHmPerWk">—</b></th>
          <th align="left" class="muted">Needed / wk = <b id="outFinalPerWk">—</b></th>
          <th align="left" class="muted">Needed / wk = <b id="outOffersPerWk">—</b></th>
          <th align="left" class="muted">Needed / wk = <b id="outHiresPerWk">—</b></th>
        </tr>
      </thead>

      <tbody id="plannerBody">
        <tr>
          <td colspan="8" class="muted">Enter values and click Calculate.</td>
        </tr>
      </tbody>
    </table>
  </div>
</section>

<script>
  const $ = (id) => document.getElementById(id);

  const SCENARIOS = {
    base:   { note: "Base: typical conversion rates", offerAccept: 0.85, finalToOffer: 0.25, hmToFinal: 0.75, riToHm: 0.50, appToRi: 0.10 },
    tight:  { note: "Capacity constrained: weaker pass-through", offerAccept: 0.80, finalToOffer: 0.20, hmToFinal: 0.60, riToHm: 0.40, appToRi: 0.08 },
    improve:{ note: "Improve CVRs: better calibration + structured screening", offerAccept: 0.88, finalToOffer: 0.30, hmToFinal: 0.80, riToHm: 0.55, appToRi: 0.12 }
  };

  function clamp01(x) {
    if (!Number.isFinite(x)) return NaN;
    return Math.max(0, Math.min(1, x));
  }

  function safeCeil(x) {
    if (!Number.isFinite(x)) return NaN;
    return Math.ceil(x);
  }

  function parseDateInput(v) {
    if (!v) return null;
    const d = new Date(v + "T00:00:00");
    return Number.isNaN(d.getTime()) ? null : d;
  }

  function addDays(d, days) {
    const out = new Date(d.getTime());
    out.setDate(out.getDate() + days);
    return out;
  }

  function startOfWeek(d) {
    const out = new Date(d.getTime());
    const day = out.getDay(); // 0=Sun
    const diffToMon = (day === 0 ? -6 : 1) - day;
    out.setDate(out.getDate() + diffToMon);
    out.setHours(0,0,0,0);
    return out;
  }

  function weekKey(d) {
    const m = d.toLocaleDateString(undefined, { month: "short" });
    const day = d.toLocaleDateString(undefined, { day: "2-digit" });
    return `${m}-${day}`;
  }

  function diffWeeks(a, b) {
    const ms = startOfWeek(b).getTime() - startOfWeek(a).getTime();
    return Math.round(ms / (7 * 24 * 60 * 60 * 1000));
  }

  function fmt(x, decimals = 1) {
    if (!Number.isFinite(x)) return "—";
    return x.toLocaleString(undefined, { maximumFractionDigits: decimals });
  }

  function roundInt(x) {
    if (!Number.isFinite(x)) return NaN;
    return Math.round(x);
  }

  function readInputs() {
    const reqOpenDate = parseDateInput($("reqOpenDate").value);
    const newHireStartDate = parseDateInput($("newHireStartDate").value);

    const weeksSourcingBeforeInterviews = parseInt($("weeksSourcingBeforeInterviews").value, 10);
    const weeksOfferToAccept = parseInt($("weeksOfferToAccept").value, 10);
    const weeksAcceptanceToStart = parseInt($("weeksAcceptanceToStart").value, 10);

    const hires = parseInt($("hires").value, 10);

    const offerAccept = clamp01(parseFloat($("offerAccept").value));
    const finalToOffer = clamp01(parseFloat($("finalToOffer").value));
    const hmToFinal = clamp01(parseFloat($("hmToFinal").value));
    const riToHm = clamp01(parseFloat($("riToHm").value));
    const appToRi = clamp01(parseFloat($("appToRi").value));

    return {
      reqOpenDate,
      newHireStartDate,
      weeksSourcingBeforeInterviews,
      weeksOfferToAccept,
      weeksAcceptanceToStart,
      hires,
      offerAccept,
      finalToOffer,
      hmToFinal,
      riToHm,
      appToRi
    };
  }

  function validate(inp) {
    if (!inp.reqOpenDate) return "Requisition Open Date is required.";
    if (!inp.newHireStartDate) return "New Hire Start Date is required.";
    if (inp.newHireStartDate.getTime() <= inp.reqOpenDate.getTime()) return "New Hire Start Date must be after Req Open Date.";

    const ints = [
      ["# Weeks Sourcing Before Interviews", inp.weeksSourcingBeforeInterviews],
      ["# Weeks Offer to Accept", inp.weeksOfferToAccept],
      ["# Weeks Acceptance to Start", inp.weeksAcceptanceToStart]
    ];
    for (const [name, v] of ints) {
      if (!Number.isFinite(v) || v < 0) return `${name} must be 0 or more.`;
    }

    if (!Number.isFinite(inp.hires) || inp.hires <= 0) return "Target hires must be >= 1.";

    const rates = [
      ["Offer accept rate", inp.offerAccept],
      ["Final → Offer", inp.finalToOffer],
      ["HM → Final", inp.hmToFinal],
      ["Recruiter Interview → HM", inp.riToHm],
      ["App → Recruiter Interview", inp.appToRi]
    ];
    for (const [name, v] of rates) {
      if (!Number.isFinite(v)) return `${name} must be a number between 0 and 1.`;
      if (v <= 0) return `${name} must be > 0 (or the funnel becomes infinite).`;
      if (v > 1) return `${name} must be <= 1.`;
    }

    return null;
  }

  function calcFunnel(inp) {
    const hires = inp.hires;

    const offersNeeded = hires / inp.offerAccept;
    const finalsNeeded = offersNeeded / inp.finalToOffer;
    const hmNeeded = finalsNeeded / inp.hmToFinal;
    const riNeeded = hmNeeded / inp.riToHm;
    const appsNeeded = riNeeded / inp.appToRi;

    return {
      offers: safeCeil(offersNeeded),
      finals: safeCeil(finalsNeeded),
      hm: safeCeil(hmNeeded),
      ri: safeCeil(riNeeded),
      apps: safeCeil(appsNeeded)
    };
  }

  // SHEET-STYLE MILESTONES:
  // Start week is the user-entered Start Date (startOfWeek).
  // Acceptance week is start week minus Acceptance->Start weeks.
  // Offer start week is acceptance week minus Offer->Accept weeks.
  // RI start week is req open week + sourcing lead.
  function computeMilestones(inp) {
    const reqW = startOfWeek(inp.reqOpenDate);
    const startW = startOfWeek(inp.newHireStartDate);

    const acceptW = addDays(startW, -7 * inp.weeksAcceptanceToStart);

    // Offer start is driven by the user input for offer->accept
    // (offers run for weeksOfferToAccept weeks starting at offerStartW)
    const offerStartW = addDays(acceptW, -7 * inp.weeksOfferToAccept);

    const appsStartW = reqW;
    const riStartW = addDays(reqW, 7 * inp.weeksSourcingBeforeInterviews);

    const hmStartW = addDays(riStartW, 7 * 1);
    const finalStartW = addDays(hmStartW, 7 * 1);

    return {
      reqW,
      appsStartW,
      riStartW,
      hmStartW,
      finalStartW,
      offerStartW,
      acceptW,
      startW
    };
  }

  // SHEET-STYLE WINDOWS + WEEKLY NEEDS
  function buildPlan(inp, milestones, funnel) {
    const errors = [];

    // RI window length comes from the calendar gap: RI start -> Offer start
    const riWeeks = diffWeeks(milestones.riStartW, milestones.offerStartW);
    if (!Number.isFinite(riWeeks) || riWeeks <= 0) {
      errors.push("Dates/timing produce no interview window (RI start must be before Offer start).");
    }

    // Stage windows (feeds-next-week dependency)
    const riW = Math.max(0, riWeeks);
    const hmW = Math.max(0, riW - 1);
    const finalW = Math.max(0, riW - 2);

    // Apps weeks rule you specified:
    // appsWeeks = sourcing lead + (riWeeks - 1)
    const appsW = Math.max(0, inp.weeksSourcingBeforeInterviews + Math.max(0, riW - 1));

    const offerW = Math.max(1, inp.weeksOfferToAccept);

    // Weekly needs are stage totals divided by THAT stage's weeks (sheet-style).
    // Use integer rounding for stage-week targets (matches how your sheet displays whole numbers).
    const appsPerWk = appsW > 0 ? roundInt(funnel.apps / appsW) : NaN;
    const riPerWk = riW > 0 ? roundInt(funnel.ri / riW) : NaN;
    const hmPerWk = hmW > 0 ? roundInt(funnel.hm / hmW) : NaN;
    const finalPerWk = finalW > 0 ? roundInt(funnel.finals / finalW) : NaN;
    const offersPerWk = offerW > 0 ? roundInt(funnel.offers / offerW) : NaN;

    // Hires per week: spread hires across the RI window (simple sheet-style indicator)
    const hiresPerWk = riW > 0 ? (inp.hires / riW) : NaN;

    return {
      errors,
      weeks: { appsW, riW, hmW, finalW, offerW },
      rates: { appsPerWk, riPerWk, hmPerWk, finalPerWk, offersPerWk, hiresPerWk }
    };
  }

  function renderHeader(inp, milestones, plan) {
    const ttf = diffWeeks(milestones.reqW, milestones.startW);

    $("outTimeToFill").textContent = Number.isFinite(ttf) ? ttf.toLocaleString() : "—";
    $("outReqOpenWeek").textContent = weekKey(milestones.reqW);

    if (plan.errors.length) {
      $("outAppsPerWk").textContent = "—";
      $("outRiPerWk").textContent = "—";
      $("outHmPerWk").textContent = "—";
      $("outFinalPerWk").textContent = "—";
      $("outOffersPerWk").textContent = "—";
      $("outHiresPerWk").textContent = "—";
      $("constraintText").textContent = plan.errors.join(" ");
      return;
    }

    $("outAppsPerWk").textContent = Number.isFinite(plan.rates.appsPerWk) ? plan.rates.appsPerWk.toLocaleString() : "—";
    $("outRiPerWk").textContent = Number.isFinite(plan.rates.riPerWk) ? plan.rates.riPerWk.toLocaleString() : "—";
    $("outHmPerWk").textContent = Number.isFinite(plan.rates.hmPerWk) ? plan.rates.hmPerWk.toLocaleString() : "—";
    $("outFinalPerWk").textContent = Number.isFinite(plan.rates.finalPerWk) ? plan.rates.finalPerWk.toLocaleString() : "—";
    $("outOffersPerWk").textContent = Number.isFinite(plan.rates.offersPerWk) ? plan.rates.offersPerWk.toLocaleString() : "—";
    $("outHiresPerWk").textContent = fmt(plan.rates.hiresPerWk, 1);

    // Constraint signal: max weekly load among visible stages (excluding hires)
    const weekly = [
      ["Applications", plan.rates.appsPerWk],
      ["Recruiter screens", plan.rates.riPerWk],
      ["HM interviews", plan.rates.hmPerWk],
      ["Final interviews", plan.rates.finalPerWk],
      ["Offers", plan.rates.offersPerWk]
    ].filter(([,v]) => Number.isFinite(v)).sort((a,b) => b[1] - a[1]);

    if (weekly.length) {
      const [topLabel, topVal] = weekly[0];
      $("constraintText").textContent = `Constraint signal: ~${topVal.toLocaleString()} ${topLabel.toLowerCase()} per week in the planned window.`;
    } else {
      $("constraintText").textContent = "Enter values and click Calculate.";
    }
  }

  function buildPlanner(inp, milestones, funnel, plan) {
    const tbody = $("plannerBody");
    tbody.innerHTML = "";

    if (plan.errors.length) {
      const tr = document.createElement("tr");
      tr.innerHTML = `<td colspan="8" class="muted">${plan.errors.join(" ")}</td>`;
      tbody.appendChild(tr);
      return;
    }

    // Display rows from req open week through start week (inclusive)
    const start = milestones.reqW;
    const end = milestones.startW;
    const totalWeeks = Math.max(1, diffWeeks(start, addDays(end, 7)));
    const weekStarts = Array.from({ length: totalWeeks }, (_, i) => addDays(start, i * 7));

    function inWindow(wStart, stageStart, lenWeeks) {
      const d = diffWeeks(stageStart, wStart);
      return d >= 0 && d < lenWeeks;
    }

    // Stage starts (sheet-style)
    const appsStart = milestones.appsStartW;               // req week
    const riStart = milestones.riStartW;                   // req + sourcing lead
    const hmStart = milestones.hmStartW;                   // ri + 1
    const finalStart = milestones.finalStartW;             // hm + 1
    const offerStart = milestones.offerStartW;             // start - lags

    const appsWeeks = plan.weeks.appsW;
    const riWeeks = plan.weeks.riW;
    const hmWeeks = plan.weeks.hmW;
    const finalWeeks = plan.weeks.finalW;
    const offerWeeks = plan.weeks.offerW;

    // Totals row (sheet-style)
    {
      const tr = document.createElement("tr");
      tr.innerHTML = `
        <td><b>${diffWeeks(milestones.reqW, milestones.startW)}</b></td>
        <td><b>${weekKey(milestones.reqW)}</b></td>
        <td><b>${funnel.apps.toLocaleString()}</b></td>
        <td><b>${funnel.ri.toLocaleString()}</b></td>
        <td><b>${funnel.hm.toLocaleString()}</b></td>
        <td><b>${funnel.finals.toLocaleString()}</b></td>
        <td><b>${funnel.offers.toLocaleString()}</b></td>
        <td><b>${inp.hires.toLocaleString()}</b></td>
      `;
      tbody.appendChild(tr);
    }

    // Weekly rows
    for (let i = 0; i < weekStarts.length; i++) {
      const wkStart = weekStarts[i];

      const apps = inWindow(wkStart, appsStart, appsWeeks) ? String(plan.rates.appsPerWk ?? "") : "";
      const ri = inWindow(wkStart, riStart, riWeeks) ? String(plan.rates.riPerWk ?? "") : "";
      const hm = (hmWeeks > 0 && inWindow(wkStart, hmStart, hmWeeks)) ? String(plan.rates.hmPerWk ?? "") : "";
      const fin = (finalWeeks > 0 && inWindow(wkStart, finalStart, finalWeeks)) ? String(plan.rates.finalPerWk ?? "") : "";
      const off = (offerWeeks > 0 && inWindow(wkStart, offerStart, offerWeeks)) ? String(plan.rates.offersPerWk ?? "") : "";

      const tr = document.createElement("tr");
      tr.innerHTML = `
        <td>${i + 1}</td>
        <td>${weekKey(wkStart)}</td>
        <td>${apps}</td>
        <td>${ri}</td>
        <td>${hm}</td>
        <td>${fin}</td>
        <td>${off}</td>
        <td></td>
      `;
      tbody.appendChild(tr);
    }
  }

  function applyScenario(key) {
    const s = SCENARIOS[key] || SCENARIOS.base;
    $("offerAccept").value = s.offerAccept;
    $("finalToOffer").value = s.finalToOffer;
    $("hmToFinal").value = s.hmToFinal;
    $("riToHm").value = s.riToHm;
    $("appToRi").value = s.appToRi;

    const note = $("scenarioNote");
    if (note) note.textContent = s.note;

    onCalculate();
  }

  function setDefaultDates() {
    const today = new Date();
    today.setHours(0,0,0,0);

    const req = startOfWeek(today);
    const start = addDays(req, 7 * 20);

    $("reqOpenDate").value = req.toISOString().slice(0,10);
    $("newHireStartDate").value = start.toISOString().slice(0,10);
  }

  function onCalculate() {
    $("error").textContent = "";
    const inp = readInputs();
    const err = validate(inp);
    if (err) { $("error").textContent = err; return; }

    const funnel = calcFunnel(inp);
    const milestones = computeMilestones(inp);
    const plan = buildPlan(inp, milestones, funnel);

    renderHeader(inp, milestones, plan);
    buildPlanner(inp, milestones, funnel, plan);
  }

  function onReset() {
    setDefaultDates();
    $("weeksSourcingBeforeInterviews").value = 1;
    $("weeksOfferToAccept").value = 1;
    $("weeksAcceptanceToStart").value = 3;
    $("hires").value = 4;

    $("error").textContent = "";
    $("constraintText").textContent = "Enter values and click Calculate.";

    applyScenario("base");
  }

  document.querySelectorAll("[data-scn]").forEach(btn => {
    btn.addEventListener("click", () => applyScenario(btn.dataset.scn));
  });

  $("calcBtn").addEventListener("click", onCalculate);
  $("resetBtn").addEventListener("click", onReset);

  [
    "reqOpenDate","newHireStartDate",
    "weeksSourcingBeforeInterviews","weeksOfferToAccept","weeksAcceptanceToStart",
    "hires","offerAccept","finalToOffer","hmToFinal","riToHm","appToRi"
  ].forEach(id => $(id).addEventListener("input", () => {
    window.clearTimeout(window.__t);
    window.__t = window.setTimeout(onCalculate, 180);
  }));

  setDefaultDates();
  applyScenario("base");
</script>