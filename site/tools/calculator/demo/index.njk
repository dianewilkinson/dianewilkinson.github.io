<div class="annot-wrap" style="margin-top:4px;">
  <div class="annot-side sht-annot">Plan Here 👇</div>

  <div style="flex:1; overflow-x:auto;">
    <table class="plan-tbl">
      <thead>
        <tr>
          <th class="col-hdr" style="min-width:60px;">Time-to-Fill (Wks)<br>Week #</th>
          <th class="col-hdr" style="min-width:90px;">Rec Open Date<br>Week Start Dates</th>
          <th class="col-hdr"># Applications Needed<br>Per Week = <span id="wkApps">—</span></th>
          <th class="col-hdr">Recruiter Screens<br>Needed Per Week = <span id="wkRi">—</span></th>
          <th class="col-hdr">#Hiring Manager Interviews<br>Needed Per Week = <span id="wkHm">—</span></th>
          <th class="col-hdr">#Final Interviews<br>Needed Per Week = <span id="wkFinal">—</span></th>
          <th class="col-hdr">#Offers Needed<br>Per Week = <span id="wkOffers">—</span></th>
          <th class="col-hdr">#Hires Needed<br>Per Week = <span id="wkHires">—</span></th>
        </tr>
      </thead>
      <tbody id="plannerBody">
        <tr><td colspan="8" style="color:#9ca3af; font-size:12px; padding:10px;">Enter values above to generate the plan.</td></tr>
      </tbody>
    </table>
    <p class="muted" id="constraintTextPlanner" style="font-size:11px; margin-top:6px;"></p>
  </div>

