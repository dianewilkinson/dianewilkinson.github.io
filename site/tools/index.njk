---
title: "Tools I Built — Diane Wilkinson"
description: "Scan a grid of workflow-first People Ops tools. Open any tool for a decision-ready overview."
pageId: "tools"
heroClass: "hero--tool"

kicker: "Tools I Built · scan-first"
backHref: "/"
backLabel: "Back to Home"

h1: 'Workflow-first tools that <span class="accent">speed decisions</span>.'
sub: "These are intentionally scoped tools—meant to plug into existing HR/TA environments, not replace them. Open any tool for a concise overview and optional deep dives (demo / playbook) when available."
permalink: "/tools/"
---

{% extends "layouts/base.njk" %}

{% block crumbs %}
  <a href="/">Home</a>
  <span class="sep">/</span>
  <span>Tools</span>
{% endblock %}

{% block ctas %}
  <span class="ctaLabel">Explore →</span>
  <a class="btn primary" href="/tools/">Tools</a>
  <a class="btn" href="/system/">System</a>
  <a class="btn" href="/use-cases/">Use Cases</a>
  <a class="btn" href="/articles/">Articles</a>
{% endblock %}

{% block content %}

  <section class="panel panel--cool" aria-label="Tools I Built">
    <div class="panelInner">
      <h2 class="section-title">Tools I Built</h2>
      <p class="sub">Scan fast. Open any tool for a decision-ready overview.</p>

      <div class="appGrid" aria-label="Tools grid">

        {% for item in tools %}
          {% if item.card %}
            <article class="appCard">
              <div class="appTop">
                <div class="appMain">
                  {# TYPE pill (top) #}
                  {% if item.card.type %}
                    <span class="badge" data-kind="{{ item.card.type }}">{{ item.card.type | replace("-", " ") | title }}</span>
                  {% endif %}

                  <h3>{{ item.card.title }}</h3>
                  <p>{{ item.card.summary }}</p>
                </div>
              </div>

              {# Bottom row: function left (subtle), explore right #}
              <div class="appActions">
                {% if item.card.function %}
                  <span class="small muted">{{ item.card.function }}</span>
                {% else %}
                  <span class="small muted"></span>
                {% endif %}
                <a class="appLink" href="{{ item.card.href }}">Explore →</a>
              </div>
            </article>
          {% endif %}
        {% endfor %}

      </div>
    </div>
  </section>

{% endblock %}
