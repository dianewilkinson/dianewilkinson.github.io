---
title: "Tools I Built — Diane Wilkinson"
description: "Scan a grid of workflow-first People Ops tools. Open any tool for a decision-ready overview."
pageId: "tools"
heroClass: "hero--tool"

kicker: "Tools · Decision Intelligence"
backHref: "/"
backLabel: "Back to Home"

h1: '<span class="accent">Decision Intelligence Tools</span> to improve hiring, not just <strong>automate workflows</strong>.'
sub: "Operational tools and intelligence systems designed for hiring."
permalink: "/tools/"
---

{% extends "layouts/base.njk" %}

{% block crumbs %}
  <a href="/">Home</a>
  <span class="sep">/</span>
  <span>Tools</span>
{% endblock %}


{% block content %}

  <section class="panel panel--cool" aria-label="Core Intelligence Tools">
    <div class="panelInner">
      <h2 class="section-title">Intelligence Tools</h2>
      <p class="sub">Open any tool for an overview.</p>

      <div class="appGrid" aria-label="Core tools grid">

        {% for item in tools | sort(false, false, "card.rank") %}
          {% if item.card and item.card.listed and item.card.section == "core" %}
            <article class="appCard">
              <div class="appTop">
                <div class="appMain">
                  <h3>{{ item.card.title }}</h3>
                  <p>{{ item.card.summary }}</p>
                </div>
              </div>
              <div class="appActions">
                {% if item.card.function %}
                  <span class="small muted">{{ item.card.function }}</span>
                {% else %}
                  <span class="small muted"></span>
                {% endif %}
                <a class="appLink" href="{{ item.card.href }}">Explore →</a>
              </div>
            </article>
          {% endif %}
        {% endfor %}

      </div>
    </div>
  </section>

  <section class="panel panel--cool" aria-label="Workflow Infrastructure Tools">
    <div class="panelInner">
      <h2 class="section-title">Foundational Tools</h2>
      <span class="muted">These tools represent the operational foundation of most recruiting systems. They address common workflow challenges and are typically implemented through vendors or built into existing infrastructure. They’re included here to show the full system behind the intelligence tools above.</span>

      <div class="appGrid" aria-label="Workflow tools grid">

        {% for item in tools | sort(false, false, "card.rank") %}
          {% if item.card and item.card.listed and (item.card.section == "workflow" or item.card.section == "foundational") %}
            <article class="appCard">
              <div class="appTop">
                <div class="appMain">
                  <h3>{{ item.card.title }}</h3>
                  <p>{{ item.card.summary }}</p>
                </div>
              </div>
              <div class="appActions">
                {% if item.card.function %}
                  <span class="small muted">{{ item.card.function }}</span>
                {% else %}
                  <span class="small muted"></span>
                {% endif %}
                {% if item.card.href %}
                  <a class="appLink" href="{{ item.card.href }}">Explore →</a>
                {% else %}
                  <span class="small muted">Assumed</span>
                {% endif %}
              </div>
            </article>
          {% endif %}
        {% endfor %}

      </div>
    </div>
  </section>

  <section class="panel panel--cool" aria-label="Playbooks">
    <div class="panelInner">
      <h2 class="section-title">Playbooks</h2>

      <div class="appGrid" aria-label="Playbooks grid">

        {% for item in tools | sort(false, false, "card.rank") %}
          {% if item.card and item.card.listed and item.card.section == "playbook" %}
            <article class="appCard">
              <div class="appTop">
                <div class="appMain">
                  <h3>{{ item.card.title }}</h3>
                  <p>{{ item.card.summary }}</p>
                </div>
              </div>
              <div class="appActions">
                {% if item.card.function %}
                  <span class="small muted">{{ item.card.function }}</span>
                {% else %}
                  <span class="small muted"></span>
                {% endif %}
                {% if item.card.href %}
                  <a class="appLink" href="{{ item.card.href }}">Explore →</a>
                {% else %}
                  <span class="small muted">Coming soon</span>
                {% endif %}
              </div>
            </article>
          {% endif %}
        {% endfor %}

      </div>
    </div>
  </section>

{% endblock %}
