---
title: "Tools I Built — Diane Wilkinson"
description: "Scan a grid of workflow-first People Ops tools. Open any tool for a decision-ready overview."
pageId: "tools"
heroClass: "hero--tool"

kicker: "Tools · Decision Intelligence"
backHref: "/"
backLabel: "Back to Home"

h1: '<span class="accent">Tools & Systems</span> I Built.'
sub: "Operational tools and intelligence systems designed for modern hiring environments."
permalink: "/tools/"
---

{% extends "layouts/base.njk" %}

{% block crumbs %}
  <a href="/">Home</a>
  <span class="sep">/</span>
  <span>Tools</span>
{% endblock %}

{% block ctas %}
  <span class="ctaLabel">Explore →</span>
  <a class="btn primary" href="/tools/">Tools</a>
  <a class="btn" href="/system/">System</a>
  <a class="btn" href="/use-cases/">Use Cases</a>
{% endblock %}

{% block content %}

  <section class="panel panel--cool" aria-label="Core Intelligence Tools">
    <div class="panelInner">
      <h2 class="section-title">Intelligence Tools</h2>
      <p class="sub">Scan fast. Open any tool for a decision-ready overview.</p>

      <div class="appGrid" aria-label="Core tools grid">

        {% for item in tools | sort(false, false, "card.rank") %}
          {% if item.card and item.card.listed and item.card.section == "core" %}
            <article class="appCard">
              <div class="appTop">
                <div class="appMain">
                  <h3>{{ item.card.title }}</h3>
                  <p>{{ item.card.summary }}</p>
                </div>
              </div>
              <div class="appActions">
                {% if item.card.function %}
                  <span class="small muted">{{ item.card.function }}</span>
                {% else %}
                  <span class="small muted"></span>
                {% endif %}
                <a class="appLink" href="{{ item.card.href }}">Explore →</a>
              </div>
            </article>
          {% endif %}
        {% endfor %}

      </div>
    </div>
  </section>

  <section class="panel tagline-panel" aria-label="Tagline">
    <div class="panelInner">
      <p class="tagline-statement"><span class="accent">Decision Science Tools</span> designed to improve hiring, not just <strong>automate workflows</strong>.</p>
    </div>
  </section>

  <section class="panel panel--cool" aria-label="Workflow Infrastructure Tools">
    <div class="panelInner">
      <h2 class="section-title">Foundational Tools</h2>

      <div class="appGrid" aria-label="Workflow tools grid">

        {% for item in tools | sort(false, false, "card.rank") %}
          {% if item.card and item.card.listed and (item.card.section == "workflow" or item.card.section == "foundational") %}
            <article class="appCard">
              <div class="appTop">
                <div class="appMain">
                  <h3>{{ item.card.title }}</h3>
                  <p>{{ item.card.summary }}</p>
                </div>
              </div>
              <div class="appActions">
                {% if item.card.function %}
                  <span class="small muted">{{ item.card.function }}</span>
                {% else %}
                  <span class="small muted"></span>
                {% endif %}
                {% if item.card.href %}
                  <a class="appLink" href="{{ item.card.href }}">Explore →</a>
                {% else %}
                  <span class="small muted">Assumed</span>
                {% endif %}
              </div>
            </article>
          {% endif %}
        {% endfor %}

      </div>
    </div>
  </section>

{% endblock %}
