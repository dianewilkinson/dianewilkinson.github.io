---
title: "Articles — Diane Wilkinson"
description: "Short, practical notes on AI-native People Ops, recruiting systems, and workflow-first automation."
pageId: "article"
heroClass: "hero--tool"

kicker: "Articles · notes & patterns"
backHref: "/"
backLabel: "Back to Home"

h1: "Articles"
sub: "Short, practical notes on building AI-native People Ops systems—workflow-first, evidence-first."
permalink: "/articles/"
---

{% extends "layouts/base.njk" %}

{% block crumbs %}
  <a href="/">Home</a>
  <span class="sep">/</span>
  <span>Articles</span>
{% endblock %}

{% block ctas %}
  <span class="ctaLabel">Explore →</span>
  <a class="btn" href="/tools/">Tools</a>
  <a class="btn" href="/system/">System</a>
  <a class="btn primary" href="/articles/">Articles</a>
{% endblock %}

{% block content %}
  <section class="panel panel--cool" aria-label="Articles">
    <div class="panelInner">
      <h2 class="section-title">Articles</h2>
      <p class="sub">More coming soon. For now:</p>

      <div class="tools-grid" aria-label="Article links">
        {% for item in articles | sort(false, false, "card.rank") %}
          {% if item.card and item.card.listed %}
            <article class="tool-card">
              <div class="tool-top">
                <div>
                  <h3>{{ item.card.title }}</h3>
                  <p>{{ item.card.summary }}</p>
                </div>
                <span class="badge">Article</span>
              </div>
              <div class="tool-actions">
                <a href="{{ item.card.href }}">Read →</a>
              </div>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>
{% endblock %}
